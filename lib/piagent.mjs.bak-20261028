/* 各子系统日志器（scope 决定日志里的 [xxx] 标签，取代原先手写的 "[xxx] " 前缀） */
const logPi = createLogger("pi");
const logBrowser = createLogger("browser");
const logSkills = createLogger("skills");
const logSub = createLogger("subagent");

/**
 * 子任务超时上限（秒）。
 *
 * 【为什么可配】硬编码 600s 对「啃一道 CTF 逆向题」这类任务远远不够：
 * 子代理往往刚把二进制反汇编完、正准备复刻解密逻辑就被砍掉，
 * 而且（旧版）连执行记录都不留 —— 等于白烧十分钟。
 * 由 config.pi.subagentMaxTimeoutSec 控制，默认 1800（30 分钟）。
 * 上限仍然存在：它是防止子任务卡死后永久占住并发位的兜底。
 */
function subTimeoutCap(sec) {
  const maxCap = Number(config.pi?.subagentMaxTimeoutSec ?? 1800);
  return Math.min(Math.max(Number(sec) || 30, 30), Math.max(maxCap, 60));
}
const logRisk = createLogger("risk");
