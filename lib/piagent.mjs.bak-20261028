/**
 * 单张图片进入上下文前的**字节**上限（超出则重编码为 JPEG）。
 *
 * 【为什么不能用「尺寸」当阈值】pi 内置 read 的 autoResizeImages 只限制**边长**
 * （2000px），而 PNG 是无损的：2000x1125 = 225 万像素 × 约 0.87 字节/像素 ≈ 2.0MB，
 * 转成 base64 再 +33% ≈ 2.6MB。实测（game1.png 2560x1440）：
 *   原图           2.82MB
 *   缩到 2000px PNG 2.09MB（base64 2.79MB）  ← 内置只做到这里
 *   2000px JPEG q72 0.27MB（base64 0.36MB）  ← 小 7.7 倍
 *   1400px JPEG q72 0.17MB（base64 0.23MB）  ← 小 12 倍
 *
 * 【为什么必须管】图片以 base64 写进会话历史后，**之后每一轮请求都要重传**。
 * 2026-09-24 事故：两条 2560x1440 游戏截图（你让 bot 看图）把私聊会话撑到 6.61MB、
 * 单次请求 5.6MB，超过上游 ~1M tokens（≈3~4.5MB 文本）的处理上限，上游在 HTTP 200
 * 的流里回 {"type":"error",...,"message":"Bad Request","statusCode":400} ——
 * 代理转成空流，bot 看到 0 个 delta 就回「模型返回了空内容」，表现为「bot 突然不说话了」。
 * 结论：按**字节**卡阈值，超了就转 JPEG。
 */
const READ_IMAGE_MAX_BYTES = 1_048_576;
/** 压缩后的最长边与质量：够看清截图文字，体积又能降一个量级 */
const READ_IMAGE_JPEG_MAX_EDGE = 1600;
const READ_IMAGE_JPEG_QUALITY = 75;

/**
 * 把 read 结果里超限的图片压成 JPEG。
 *
 * 只动 type==="image" 的部分，其余内容（文本/截断信息）原样保留；
 * 压缩失败（如 sharp 不可用、图片损坏）时**保留原图**并让调用继续 —— 宁可贵一点，
 * 也不要因为压不了图就把 read 弄失败。
 *
 * @param {{content?:Array}} result read 工具返回
 * @returns {Promise<{content?:Array}>} 可能被替换过图片的结果
 */
async function shrinkLargeImages(result) {
  const parts = result?.content;
  if (!Array.isArray(parts)) return result;
  const imgs = parts.filter((p) => p?.type === "image" && typeof p.data === "string");
  if (!imgs.length) return result;

  let sharp = null;
  try {
    sharp = (await import("sharp")).default;
  } catch {
    return result; // 没有 sharp 就不动（不引入新失败点）
  }

  let changed = false;
  const notes = [];
  const out = [];
  for (const p of parts) {
    if (p?.type !== "image" || typeof p.data !== "string") {
      out.push(p);
      continue;
    }
    const bytes = Math.floor((p.data.length * 3) / 4); // base64 → 原始字节
    if (bytes <= READ_IMAGE_MAX_BYTES) {
      out.push(p);
      continue;
    }
    try {
      const jpeg = await sharp(Buffer.from(p.data, "base64"))
        .resize({ width: READ_IMAGE_JPEG_MAX_EDGE, height: READ_IMAGE_JPEG_MAX_EDGE, fit: "inside", withoutEnlargement: true })
        .jpeg({ quality: READ_IMAGE_JPEG_QUALITY, mozjpeg: true })
        .toBuffer();
      const mb = (b) => (b / 1048576).toFixed(2);
      notes.push(`[图片已压缩：${mb(bytes)}MB → ${mb(jpeg.length)}MB，JPEG q${READ_IMAGE_JPEG_QUALITY}，最长边 ≤${READ_IMAGE_JPEG_MAX_EDGE}px。原图仍在磁盘上，需要看细节可以裁切后再读]`);
      out.push({ ...p, data: jpeg.toString("base64"), mimeType: "image/jpeg" });
      changed = true;
    } catch {
      out.push(p); // 压不了就原样返回
    }
  }
  if (!changed) return result;
  out.push({ type: "text", text: notes.join("\n") });
  return { ...result, content: out };
}

/**
 * 带图片压缩的 read 工具：包住 pi 内置 read，在它之后再过一道字节闸。
 *
 * 【为什么要包而不是重写】内置 read 还负责截断、行号、PDF、图片缩放等行为，
 * 重写会漏掉细节；这里只在其结果上做一次“大图转 JPEG”。
 */
function createReadToolShrinkingImages(cwd) {
  const base = createReadTool(cwd, { autoResizeImages: true });
  const tool = defineTool({
    name: base.name,
    description: base.description,
    parameters: base.parameters,
    execute: async (...callArgs) => shrinkLargeImages(await base.execute(...callArgs)),
  });
  return tool;
}

class PiAgent {
  /** 命令别名（/mem、/memmory → memory 等） */
  static ALIASES = { mem: "memory", memmory: "memory", mems: "memory", st: "status", r: "restart", sx: "strix" };

  /**
   * 内置命令注册表（仅管理员，统一由 handleCommand 鉴权）。
   * 【新增命令】只需在此添加一项 { name, desc, usage?, run(self, ctx, rest) }，/help 自动生成。
   */
  static BUILTIN = {
    help: {
      desc: "本帮助",
      usage: "",
      run: (self) => [
        "可用命令（仅管理员）：",
        "  $ 命令     执行 Linux Bash（如：$ df -h）",
        "  > 命令     执行 Windows Shell（如：> tasklist）",
        ...Object.entries(PiAgent.BUILTIN).map(([n, e]) => `  /${n}      ${e.desc}`),
      ].join("\n"),
    },
    status: {
      desc: "系统状态",
      usage: "",
      run: async (self, ctx) => {
        const stats = self.memory?.stats();
        const botQQ = config.napcat?.qqAccount ?? "?";
        const lines = [
          `PI2X 在线 · ${botQQ}`,
          `模型 ${self.model?.id ?? "?"}`,
          `记忆 ${stats?.total ?? 0} 条 · 全局 ${stats?.globals ?? 0}`,
          `会话 ${self.sessions.size} 活跃`,
          ...(await self._statusContextUsage(ctx)),
        ];
        // Command Code 号池用量 + 缓存命中率（取不到就不显示，不阻塞 /status）
        try {
          const cc = await ccUsageStatusLines();
          if (cc) { lines.push(""); lines.push(...cc.split("\n")); }
        } catch (e) {
          lines.push(`CC 号池 取数异常：${String(e?.message ?? e).slice(0, 60)}`);
        }
        return lines.join("\n");
      },
    },
    model: {
      desc: "查看/切换模型（/model 编号）",
      usage: "[编号|别名]",
      run: async (self, ctx, rest) => {
        // 自动生成菜单：omniroute/*（网关模型）+ deepseek/*（直连模型）
        const buildMenu = () => {
          const arr = [];
          for (const m of self._omModels ?? []) arr.push({ id: `omniroute/${m.id}`, label: `omniroute/${m.id}` });
          const ds = (self.modelRuntime.getModels?.() ?? []).filter((m) => m.provider === "deepseek").map((m) => m.id).sort();
          for (const id of ds) arr.push({ id: `deepseek/${id}`, label: `deepseek/${id}` });
          const seen = new Set();
          return arr.filter((it) => (seen.has(it.id) ? false : (seen.add(it.id), true)));
        };
        const menu = buildMenu();
        if (!rest.length) {
          const cur = self.model ? `${self.model.provider}/${self.model.id}` : "?";
          const lines = [`当前模型: ${cur}`, "切换: /model <编号>", ""];
          menu.forEach((it, i) => lines.push(`[${i}] ${it.id}`));
          return lines.join("\n");
        }
        const t = String(rest[0]);
        const pick = async (cliModel) => {
          const rr = resolveCliModel({ cliModel, modelRuntime: self.modelRuntime });
          return rr.error ? null : rr.model;
        };
        let cliModel = null;
        if (/^\d+$/.test(t)) {
          const it = menu[Number(t)];
          if (!it) return `编号 ${t} 不存在，输入 /model 查看列表。`;
          cliModel = it.id;
        } else {
          const low = t.toLowerCase();
          // deepseek 硬编码真实默认模型（config.pi.model 可能被 /model 持久化污染，不能依赖它）
          if (low === "deepseek" || low === "ds") cliModel = "deepseek/deepseek-v4-flash-vision-exp";
          else if (low === "free" || low === "auto") cliModel = "omniroute/free";
          else if (low === "flash" || low === "deepseek-flash" || low === "ds-flash") cliModel = "omniroute/openai/deepseek-flash";
          else cliModel = t.includes("/") ? t : `omniroute/${t}`;
        }
        const m = await pick(cliModel);
        if (!m) return `模型解析失败(${cliModel})，输入 /model 查看。`;
        // 更新本对象（新会话）
        self.model = m;
        // 更新所有活跃会话（persist:false 不落盘）
        let n = 0;
        for (const [, entry] of self.sessions) {
          try { await entry.session.setModel?.(m, { persist: false }); n++; } catch (e) { /* 单会话失败不阻塞 */ }
        }
        // 持久化到 config.json（重启后仍生效）
        let saved = "";
        try {
          saveConfig((cfg) => {
            cfg.pi = cfg.pi ?? {};
            cfg.pi.model = cliModel;
            return cfg;
          });
          saved = "· 已持久化（重启保留）";
        } catch (e) { saved = "· 持久化失败（仅本次运行）"; }
        return `已切换模型: ${m.provider}/${m.id} · 更新 ${n} 个活跃会话 ${saved}`;
      },
    },
    memory: {
      desc: "记忆查询/清理（/mem [search 词|list|delete id|clear|词]）",
      usage: "[search <词>] [list [n]] [delete <id>] [clear] 或直接 /mem <词>",
      run: async (self, ctx, rest) => {
        const m = self.memory;
        if (!m) return "（记忆系统未启用）";
        const fmt = (rows, title) => {
          if (!rows.length) return `${title}：无匹配记录`;
          const lines = rows.map((r) => {
            const ago = (() => {
              const diff = Date.now() - r.ts;
              const m = Math.floor(diff / 60000);
              if (m < 1) return "刚刚";
              if (m < 60) return `${m}分钟前`;
              const h = Math.floor(m / 60);
              if (h < 24) return `${h}小时前`;
              return `${Math.floor(h / 24)}天前`;
            })();
            return `- [${r.type} · ${ago}] ${r.content}${r.sensitive ? " 🔒" : ""}`;
          });
          return `${title} ${rows.length} 条：\n` + lines.join("\n");
        };
        if (!rest.length) {
          const s = m.stats();
          const es = m.embedderState?.() ?? {};
          const embLine = s.embOk >= s.total
            ? `向量 ${s.embOk}/${s.total} · 模型 ${es.model ?? "?"}(${es.dim ?? "?"}维)`
            : `向量 ${s.embOk}/${s.total} ⚠️ 未就绪(${es.error ?? "embedding 不可用，已降级关键词检索"})`;
          return [
            `事实 ${s.total} 条（pinned ${s.pinned} · sensitive ${s.sensitive}）`,
            `类型: ${s.byType.map((t) => `${t.type}=${t.c}`).join(" ") || "无"}`,
            embLine,
            `收割 ${s.harvest.count} 次 · 全局常驻 ${s.globals} 条`,
            `子命令: /mem search <词> · /mem list · /mem delete <id> · /mem clear · /mem <词>`,
          ].join("\n");
        }
        const sub = String(rest[0]).toLowerCase();
        if (sub === "list") {
          return fmt(m.list({ limit: Math.min(Number(rest[1] ?? 20), 100) }), "最近记忆");
        }
        if (sub === "add" || sub === "remember") {
          const content = rest.slice(1).join(" ").trim();
          if (!content) return "用法: /mem add <内容>（永久记录，不淘汰）";
          const source = memorySourceOf(ctx) ?? `private:${ctx.userId}`;
          const r = await m.remember({ content, source, pinned: true });
          return r.ok
            ? `已永久记住${r.degraded ? "（⚠️ 向量未就绪，本次以关键词模式存入）" : ""}：${content.slice(0, 120)}`
            : `写入失败：${r.error ?? "未知"}`;
        }
        if (sub === "del" || sub === "delete") {
          const n = m.deleteById(String(rest[1] ?? ""));
          return n ? `已删除 ${n} 条` : `未找到 id=${rest[1] ?? ""}`;
        }
        if (sub === "clear" || sub === "purge") {
          const r = m.purgeDirty();
          return `已清除脏数据：孤儿记忆 ${r.facts} 条、空收割日志 ${r.harvest} 条。有效记忆与权限未受影响。`;
        }
        const kw = sub === "search" ? rest.slice(1).join(" ") : rest.join(" ");
        const rows = await m.search({ keyword: kw, chatType: ctx.chatType, limit: 10 });
        return fmt(rows, `搜索「${kw}」`);
      },
    },
    perms: {
      desc: "查看用户权限（/perms QQ号）",
      usage: "[QQ号]",
      run: (self, ctx, rest) => {
        const target = (rest[0] ?? ctx.userId).trim();
        const p = self.white.list(String(target));
        return `${target}: ${p.length ? p.join(", ") : "dialog（最低权限）"}`;
      },
    },
    whoami: {
      desc: "当前会话信息（加参数查看权限明细，如 /whoami 1）",
      usage: "[- 任意参数展开权限明细]",
      run: (self, ctx, rest) => {
        const base = `会话: ${ctx.chatType === "group" ? "群聊" : "私聊"} · 你的 QQ: ${ctx.userId} · 权限组: ${self.white.presetOf(ctx.userId)}`;
        if (rest && rest.length > 0) return base + `\n权限明细: ${self.white.list(ctx.userId).join(", ") || "（无）"}`;
        return base;
      },
    },
    cred: {
      desc: "凭据管理（/cred [list|get <域名>|del <域名>]）— 仅 admin；解密不在此显示明文",
      usage: "[list] [get <域名>] [del <域名>]",
      run: async (self, ctx, rest) => {
        if (!self.white.perms(ctx.userId).has("files:full")) return "越权：cred 仅系统管理员可用。";
        const sub = String(rest[0] || "list").toLowerCase();
        const { createCredentialStore } = await import("./credentials.mjs");
        const cs = createCredentialStore();
        try {
          if (sub === "list") {
            const rows = cs.list();
            if (!rows.length) return "（无凭据）";
            return "凭据列表：\n" + rows.map((r) => `- ${r.domain}${r.username ? ` (${r.username})` : ""}${r.hasPass ? " [密码]" : ""}${r.hasToken ? " [token]" : ""}`).join("\n");
          }
          if (sub === "get" || sub === "lookup") {
            const domain = String(rest[1] ?? "");
            if (!domain) return "用法: /cred get <域名>";
            const r = cs.get(domain);
            return r.ok ? `${r.domain}: 用户=${r.username || "-"} 密码=${r.password ? "已存" : "-"} token=${r.token ? "已存" : "-"}` : r.text;
          }
          if (sub === "del" || sub === "delete" || sub === "remove") {
            const domain = String(rest[1] ?? "");
            if (!domain) return "用法: /cred del <域名>";
            const n = cs.remove(domain);
            return n ? `已删除凭据 ${domain}` : `未找到 ${domain}`;
          }
          return "用法: /cred [list|get <域名>|del <域名>]";
        } finally {
          cs.close();
        }
      },
    },
    strix: {
      desc: "切换/管理 strix 框架（仅 admin 私聊）",
      usage: "[new <目标> [--mode quick] [--budget 2]] | ls | use <编号|run名> | status | off | report [run名]",
      run: async (self, ctx, rest) => {
        const sub = String(rest[0] ?? "").toLowerCase();
        const userId = String(ctx?.userId ?? "");
        const chatKey = ctx?.chatType === "group" ? `group:${ctx.targetId}` : `private:${userId}`;

        // ── 硬门禁：仅 admin 私聊 ─────────────────────────────────────
        // 【为什么群聊一律禁止】strix 是渗透引擎，产出含漏洞细节、PoC、可利用
        // 路径。这些内容一旦发进群，等于把目标的弱点给所有群成员看了；而且
        // strix 不受 PI2X 主 agent 的工具白名单约束（它自己一套命令执行/网络能力），
        // 群场景下无法确保只能由授权人驱动。所以群聊不开口子，不区分群类型。
        if (ctx?.chatType === "group") {
          return "strix 框架仅限私聊使用（群聊不开放）。请私聊我操作。";
        }

        // ── 无参数 / status：看一眼再决定 ──
        if (!sub || sub === "status" || sub === "st") {
          const cur = sst.peekStrixSession(userId, chatKey);
          const lines = ["strix 框架（本地黑盒渗透引擎）"];
          if (cur?.alive) {
            const st = await cur.status();
            lines.push(
              `状态：已接入 · 会话 ${cur.resolvedRunName ?? cur.runName} · agent ${st?.root_status ?? "?"}`,
              `轮次 ${st?.turns ?? 0} · 花费 $${Number(st?.cost_usd ?? 0).toFixed(4)}`,
              `子代理 ${Object.keys(st?.agents ?? {}).length} 个`,
            );
          } else if (sst.peekStrixSession(userId, chatKey)?.hasPending) {
            const p = sst.peekStrixSession(userId, chatKey);
            lines.push(`状态：已登记会话 ${p.runName ?? "(新建)"}，等你说第一句话就开始`);
          } else {
            lines.push("状态：未接入（当前走 PI2X 主框架）");
            // 重启后内存实例池是空的，但上次用过的会话还在 —— 直接告诉他，
            // 省得自己去 /strix ls 里翻（但不自动接管：见 lastSessionOf 注释）。
            const last = sst.lastSessionOf(userId);
            if (last) {
              lines.push(`上次会话：${last.runName}（想接着用：/strix use ${last.runName}）`);
            }
          }
          lines.push(
            "",
            "用法：",
            "  /strix new <目标> [--mode quick|standard|deep] [--budget N]   新建会话并接入",
            "  /strix ls [n]                                               列出历史会话",
            "  /strix use <编号|run名> [指令]                              接回旧会话",
            "  /strix status                                               当前状态",
            "  /strix off                                                  退出 strix（回 PI2X）",
            "  /strix report [run名]                                       看报告",
            "接入后：直接把要说的话发给我，我在 strix 里执行；/pi2x 退回主框架。",
          );
          return lines.join("\n");
        }

        // ── new：新建会话并接入 ──
        // 语法：/strix new <会话名> [目标...] [--mode ...] [--budget N] [--turns N] [--dir <目录>]
        //
        // 【为什么第一个位置参数是会话名而不是目标】用户要的是「给会话起个名字」，
        // 不是「先指定一个扫描目标」（他的原话：「我只想 new 一个 session 名」）。
        // 目标可以后补：接进会话后直接说要扫什么即可，strix 本来就是交互式的。
        // 目标也不限于 URL —— 仓库、本地目录/文件、OpenAPI 规格、IP 都是合法目标，
        // 所以这里**不做格式校验**，交给 strix 自己判（它报错也会被我们带回来）。
        if (sub === "new") {
          const targets = [];
          let mode = "quick";
          // 默认不限制（strix 原生默认就是 None / 500）；只有用户显式给了才传
          let budget = null;
          let turns = null;
          let name = "";
          let dir = "";
          for (let i = 1; i < rest.length; i++) {
            const a = rest[i];
            if (a === "--mode" || a === "-m") mode = String(rest[++i] ?? "quick");
            else if (a === "--budget") budget = Number(rest[++i]) || null;
            else if (a === "--turns") turns = Number(rest[++i]) || null;
            else if (a === "--name") name = String(rest[++i] ?? "");
            else if (a === "--dir" || a === "--workspace") dir = String(rest[++i] ?? "");
            else if (!a.startsWith("-")) {
              if (!name) name = a;
              else targets.push(a);
            }
          }
          if (!name) {
            return [
              "用法：/strix new <会话名> [目标...] [选项]",
              "  会话名   必填，就是你想给这个会话起的名字（如 /strix new tyxsjpt）",
              "  目标     可选。URL / IP / 域名 / 本地目录或文件（OpenAPI 规格也行）。",
              "           不给也行 —— 接进会话后直接说要扫什么。",
              "  --dir <目录>   无目标会话时，让 agent 在这个目录里干活",
              "  --mode quick|standard|deep（默认 quick）",
              "  --budget N（默认 $2）  --turns N（默认 30）",
              "例：/strix new tyxsjpt",
              "    /strix new myscan https://example.com --mode quick",
              "    /strix new audit /opt/pi2x/strix/target-test --dir /opt/pi2x/strix/target-test",
            ].join("\n");
          }
          // 名字随便起（中文、空格都行）—— 落盘名由 slugOf 转成安全目录名。
          // 只挡两类别有用心思的：路径分隔符（防目录穿越）与控制字符。
          if (/[\/\\]/.test(name) || /[\x00-\x1f\x7f]/.test(name)) {
            return "会话名不能含斜杠或控制字符。";
          }
          if (name.length > 48) return `会话名太長（${name.length} 字，最多 48）。`;
          if (!["quick", "standard", "deep"].includes(mode)) return `模式只能是 quick / standard / deep（收到 ${mode}）`;
          if (!sst.isStrixToolReady()) return "strix 引擎未就绪（缺 venv 或补丁未应用）：先跑 node scripts/strix-cli.mjs status";

          // 会话名重名保护：strix 的 run 目录就是这个名字，已存在会被覆盖/接续，
          // 容易把「新建」变成「悄悄接着旧的跑」。明确拒绝，让用户改名或 use。
          const slug = sst.StrixSession.slugOf(name);
          const exists = sst
            .listStrixSessions(500)
            .some((r) => r.runName === slug || (r.label && r.label === name));
          if (exists) {
            return [
              `会话名 ${name} 已存在。`,
              `· 想接着用：/strix use ${name}`,
              `· 想新建：换个名字（如 ${name}2）`,
            ].join("\n");
          }

          // 换会话：先停掉自己的旧 worker（不影响其他用户）
          await sst.dropStrixSession(userId, chatKey);
          const sess = sst.getStrixSession({ userId, chatKey });
          // 【懒启动】这里只登记，不拉进程 —— 纯属刻意：
          //   · 只给名字时拉起 strix，它拿到的是空任务，不知道该干什么；
          //   · 且 strix 会拒绝恢复「无目标无指令」的会话（实测 run.json has no targets_info）。
          // 让**第一句话**既当首轮任务、又成为可恢复的历史，两个问题一起解决。
          sess.setPending({ sessionName: name, label: name, targets, mode, budget, turns, workspace: dir || null });
          return [
            `已新建 strix 会话 ${name}`,
            targets.length ? `目标 ${targets.join(" ")} · 模式 ${mode}` : null,
            [budget != null ? `预算 $${budget}` : null, turns != null ? `上限 ${turns} 轮` : null]
              .filter(Boolean)
              .join(" · ") || null,
            "",
            "退出：/pi2x。其他用户不受影响，仍走 PI2X。",
          ].filter(Boolean).join("\n");
        }

        // ── ls：列历史会话 ──
        if (sub === "ls" || sub === "list") {
          const n = Number(rest[1]) || 10;
          const list = sst.listStrixSessions(n);
          if (!list.length) return "还没有 strix 会话。用 /strix new <会话名> 建一个。";
          // 只列「名称 · 时间 · 花费」三项（按用户要求精简）：
          // 状态/模式/目标/漏洞数在选会话时用不上，堆上去只会淹掉真正要选的编号和名字。
          const lines = [`最近 ${list.length} 个 strix 会话：`];
          list.forEach((s, i) => {
            const when = new Date(s.mtime).toLocaleString("zh-CN");
            // 显示用户起的名字；没有标签的老会话才回退内部目录名
            const shown = s.label ?? s.runName;
            lines.push(`[${i}] ${shown}  ·  ${when}  ·  $${s.cost.toFixed(4)}`);
          });
          lines.push("", "接回某个会话：/strix use <编号|run名> [可选新指令]");
          return lines.join("\n");
        }

        // ── use：接回旧会话 ──
        if (sub === "use" || sub === "resume") {
          const pick = String(rest[1] ?? "");
          if (!pick) return "用法：/strix use <编号|run名> [新指令]\n先用 /strix ls 看有哪些。";
          const list = sst.listStrixSessions(50);
          let runName = pick;
          if (/^\d+$/.test(pick)) {
            const hit = list[Number(pick)];
            if (!hit) return `编号 ${pick} 不存在，用 /strix ls 看看。`;
            runName = hit.runName;
          } else {
            // 用户看到的是「他起的名字」（label），不是落盘 slug —— 三种都能认：
            // 显示名精确匹配、内部名精确匹配、内部名前缀匹配
            const hit =
              list.find((s) => (s.label ?? s.runName) === pick) ??
              list.find((s) => s.runName === pick) ??
              list.find((s) => s.runName.startsWith(pick));
            if (!hit) return `找不到会话 ${pick}，用 /strix ls 看看。`;
            runName = hit.runName;
          }
          await sst.dropStrixSession(userId, chatKey);
          const sess = sst.getStrixSession({ userId, chatKey });
          const extra = rest.slice(2).join(" ").trim();
          sess.runName = runName;
          if (extra) {
            // 给了指令：直接把这句话当新一轮注入（strix 的 --instruction 原生语义）
            try {
              const r = await sess.start({ instruction: extra });
              return [`已接回 strix 会话 ${r.runName}`, `已把这条作为新一轮指令注入：${extra}`, "", "接着说就行；/pi2x 退出。"].join("\n");
            } catch (e) {
              return `接回失败：${e?.message}`;
            }
          }
          // 没给指令：登记恢复，等下一句话时再拉起（同 new 的理由：需要有任务可依）
          // 恢复时把显示名也带上，ls 才不会退回显示内部 slug
          const hit0 = sst.listStrixSessions(500).find((s) => s.runName === runName);
          sess.label = hit0?.label ?? null;
          sess.setPending({ resume: true, label: hit0?.label ?? null });
          return [
            `已接回 strix 会话 ${runName}`,
            "接着说话就行 —— 下一句会作为新一轮指令交给它。",
            "退出：/pi2x。",
          ].join("\n");
        }

        // ── off：退出 strix ──
        if (sub === "off" || sub === "exit") {
          const ok = await sst.dropStrixSession(userId, chatKey);
          return ok ? "已退出 strix 框架，回到 PI2X 主框架。" : "（当前本来就没在 strix 框架）";
        }

        // ── report：看报告 ──
        if (sub === "report" || sub === "findings") {
          const cur = sst.peekStrixSession(userId, chatKey);
          let runName = String(rest[1] ?? "") || cur?.resolvedRunName || cur?.runName;
          if (!runName) {
            const list = sst.listStrixSessions(1);
            if (!list.length) return "还没有 strix 会话。";
            runName = list[0].runName;
          }
          const sum = sst.readRunSummary(runName);
          if (!sum.exists) return `找不到会话 ${runName}。`;
          if (sub === "findings") {
            const v = sum.meta?.scan_results?.vulnerabilities ?? [];
            if (!v.length) return `${runName}：未发现漏洞（注意看预算/轮次是否触顶，触顶会提前收尾）`;
            const lines = [`${runName} 发现 ${v.length} 个漏洞：`];
            for (const x of v) {
              lines.push(`[${String(x.severity ?? "?").toUpperCase()}] ${x.title ?? x.id ?? "(无标题)"}`);
              if (x.endpoint || x.url) lines.push(`  位置 ${x.endpoint || x.url}`);
            }
            return lines.join("\n");
          }
          const rep = sum.report ?? "";
          if (!rep) return `${runName} 还没有报告（扫描可能未结束）。`;
          return rep.length > 1600 ? rep.slice(0, 1600) + "\n…（截断，完整报告在 " + sst.runDirOf(runName) + "）" : rep;
        }

        return `未知子命令 ${sub}。用 /strix 看用法。`;
      },
    },
    pi2x: {
      desc: "从 strix 框架切回 PI2X 主框架",
      usage: "",
      run: async (self, ctx) => {
        const userId = String(ctx?.userId ?? "");
        const chatKey = ctx?.chatType === "group" ? `group:${ctx.targetId}` : `private:${userId}`;
        // 群聊本就不允许开 strix，这里保持一致（万一日后有人放宽了切换入口，
        // 退出路径也不会变成绕过点）
        if (ctx?.chatType === "group") return "strix 框架仅限私聊使用（群聊不开放）。";
        const ok = await sst.dropStrixSession(userId, chatKey);
        return ok ? "已切回 PI2X 主框架（strix 会话已收尾，历史仍可用 /strix use 接回）。" : "（当前本来就在 PI2X 主框架）";
      },
    },
    restart: {
      desc: "重启整个服务",
      usage: "",
      run: (self, ctx) => {
        // 先让回复发出，再重启整个 bridge 服务（独立脚本：pkill + nohup 拉起）
        const uid = String(ctx?.userId ?? "");
        const ctype = ctx?.chatType === "group" ? "group" : "private";
        const tid = String(ctx?.chatType === "group" ? ctx?.targetId : ctx?.userId ?? "");
        setTimeout(async () => {
          try {
            const { spawn } = await import("node:child_process");
            const script = path.join(ROOT, "scripts", "restart-pi2x.sh");
            const env = { ...process.env, PI2X_RESTART_UID: uid, PI2X_RESTART_CHAT: ctype, PI2X_RESTART_TARGET: tid };
            spawn("bash", [script], { detached: true, stdio: "ignore", env }).unref();
          } catch {}
        }, 300);
        return "正在重启服务…";
      },
    },
    stop: {
      desc: "中止当前正在运行的任务（含 subagent）",
      usage: "",
      run: async (self) => {
        let n = 0;
        for (const [, entry] of self.sessions) {
          try { await entry.asm.cancelAll("（已中止）"); n++; } catch {}
        }
        n += await self._stopSubs(); // 中止 subagent（Windows pi RPC + Linux 子会话）
        return n ? `已中止 ${n} 个会话/子代理中正在运行的任务。` : "（当前无任务运行）";
      },
    },
    op: {
      desc: "授予权限预设（/op QQ号 预设）",
      usage: "<QQ号> <friend|operator|admin>",
      run: async (self, ctx, rest) => {
        const r = await self._opUser(ctx.userId, String(rest[0] ?? ""), String(rest[1] ?? ""));
        return r.text;
      },
    },
    deop: {
      desc: "撤销权限（/deop QQ号）",
      usage: "<QQ号>",
      run: async (self, ctx, rest) => {
        const r = await self._deopUser(ctx.userId, String(rest[0] ?? ""));
        return r.text;
      },
    },
  };

  /** 预设等级表（防提权比较用） */
  /** 预设等级表 —— 唯一实现在 lib/op-policy.mjs（与 qq-cli 共用，避免两侧漂移） */
  static PRESET_LEVEL = PRESET_LEVEL_TABLE;

  _saveWhitelist(mutate) {
    const file = WHITELIST_PATH;
    const raw = JSON.parse(fs.readFileSync(file, "utf8"));
    raw.users ??= {};
    mutate(raw.users);
    fs.writeFileSync(file, JSON.stringify(raw, null, 2) + "\n", { mode: 0o600 });
    this.white.load(true); // 强制重载，立即生效
  }

  /**
   * 授予权限（/op 命令与 qq-cli op 共用同一策略）。
   *
   * 规则见 lib/op-policy.mjs —— 与 qq-cli 那侧**同一份实现**，避免两侧漂移出提权缺口。
   * 拒绝文案刻意不带等级数字：否则任何群成员都能靠试错探出谁有权限、权限多高。
   */
  async _opUser(caller, target, preset) {
    if (!target) return { ok: false, text: "用法: /op <QQ号> <friend|operator|admin>" };
    const raw = JSON.parse(fs.readFileSync(WHITELIST_PATH, "utf8"));
    const r = checkGrant({
      callerPreset: raw.users?.[caller],
      targetPreset: raw.users?.[target],
      preset: String(preset ?? ""),
    });
    if (!r.ok) return { ok: false, text: r.text };
    this._saveWhitelist((users) => { users[target] = preset; });
    if (this.memory) this.memory.setUserPerm(target, preset, caller);
    return { ok: true, text: `已授予 ${target} 预设「${preset}」（热加载生效）` };
  }

  /** 撤销权限（/deop 命令与 qq-cli deop 共用同一策略） */
  async _deopUser(caller, target) {
    if (!target) return { ok: false, text: "用法: /deop <QQ号>" };
    const raw = JSON.parse(fs.readFileSync(WHITELIST_PATH, "utf8"));
    if (!(target in (raw.users ?? {}))) {
      // 措辞不说「该用户无授权」—— 那等于确认某个 QQ 在不在白名单里
      return { ok: false, text: "该用户当前无需撤销的权限。" };
    }
    const r = checkRevoke({
      callerPreset: raw.users?.[caller],
      targetPreset: raw.users?.[target],
      isTargetSelf: String(caller) === String(target),
    });
    if (!r.ok) return { ok: false, text: r.text };
    this._saveWhitelist((users) => { delete users[target]; });
    if (this.memory) this.memory.setUserPerm(target, "dialog", caller);
    return { ok: true, text: `已撤销 ${target} 的授权（恢复 dialog 最低权限）` };
  }

  constructor({ bridge }) {
    this.bridge = bridge;          // QQBridge 实例（供主动发消息工具）
    this.modelRuntime = null;
    this.loader = null;            // 统一 ResourceLoader（无角色分级）
    this.model = undefined;        // 按 config.pi.model 解析
    this.sessions = new Map();     // chatKey -> { session, tail: Promise, context }
    this._pending = new Map();     // chatKey -> Promise（防止并发重复创建会话）
    this.ctx = { chatType: null, targetId: null, selfId: null, userName: null, userId: null, chatKey: null };
    this.white = null;             // Whitelist 实例
    this.memory = null;            // MemoryStore 实例
    this.sandboxRoot = null;       // 沙盒根目录
    this._groupNameCache = new Map(); // 群号 -> Promise<群名>
    this._groupMembers = new Map();   // 群号 -> Map<QQ, 昵称>（消息流增量维护，供 @解析与上下文注入）
    this._subAbort = null;         // 当前 subagent 任务取消器（AbortController）
    this._activeSubSessions = new Set(); // 运行中的 Linux 子会话（可中止）
    this._subTasks = new Map();    // taskId -> 异步子任务状态（纯异步：启动即返回 taskId，可 steer/取结果）
  }

  async init(opts = {}) {
    const wlFile = opts.whitelistFile ?? WHITELIST_PATH;
    const { Whitelist } = await import("./whitelist.mjs");
    this.white = new Whitelist(wlFile);

    // 启动清扫：子代理的一次性会话文件在正常结束时会被 unlink，
    // 但进程被 kill（重启/OOM）时子代理正在跑 → 那个文件就永久成了孤儿。
    // 启动瞬间不可能有子代理在跑，所以这里看到的全是孤儿，可直接删。
    try {
      const { sweepOrphans } = await import("./sessions-maint.mjs");
      const r = sweepOrphans(SESSIONS_DIR);
      if (r.removed.length) {
        log.info(`[boot] 清理 ${r.removed.length} 个子代理孤儿会话文件，释放 ${(r.freed / 1024 / 1024).toFixed(2)}MB`);
        for (const f of r.removed) log.debug(`  已删 ${f.name}（${(f.bytes / 1024).toFixed(0)}KB）`);
      }
    } catch (e) {
      log.warn(`[boot] 孤儿会话清扫失败：${e?.message}`);
    }

    if (config.memory?.enabled !== false) {
      const { createMemoryStore } = await import("./memory.mjs");
      // 走 resolveDataPath：配置里的 "./workspace/xxx" 会自动映射到 private/workspace/xxx
      const dbPath = resolveDataPath(config.memory?.dbPath, path.join(WORKSPACE, "memories", "memory.db"));
      const sc = config.memory?.scoring ?? {};
      this.memory = createMemoryStore({
        dbPath,
        modelDir: config.memory?.modelDir ? resolveDataPath(config.memory.modelDir) : path.join(WORKSPACE, "memories", "models"),
        harvestIntervalMs: config.memory.harvestIntervalMin * 60000,
        maxFacts: config.memory.maxFacts,
        injectChars: config.memory.injectChars,
        harvestModel: config.memory?.harvestModel ?? "deepseek-chat",
        embedModel: config.memory?.embedModel,
        embedPrefixQuery: config.memory?.embedPrefixQuery ?? "",
        embedPrefixPassage: config.memory?.embedPrefixPassage ?? "",
        center: sc.center,
        useCsls: sc.useCsls,
        cslsK: sc.cslsK,
        gateSim: sc.gateSim,
        mergeSim: sc.mergeSim,
        relatedSim: sc.relatedSim,
        recencyDecay: sc.recencyDecay,
        evictMode: sc.evictMode,
        autoSupersede: sc.autoSupersede,
        weights: sc.weights,
      });
    }
    // 沙箱根：优先用配置里的 sandboxDir，否则用 config 导出的 SANDBOX_DIR
    // （private/sandbox 优先，否则旧布局的 <root>/sandbox）
    this.sandboxRoot = resolveDataPath(config.memory?.sandboxDir, SANDBOX_DIR);

    // 模型与 provider 装配：与安全模式共用同一份实现（lib/model-config.mjs），
    // 避免「两个入口各写一遍 provider 注册」导致配置漂移。
    this.modelRuntime = await createModelRuntime({ logger: logPi });
    this._omModels = OMNIROUTE_MODELS; // /model 菜单自动生成用
    // 确保 headless Chrome（CDP 9222）可用：供 browser_* 工具使用
    this._ensureChrome().catch((e) => logBrowser.warn(`chrome 自启异常: ${e?.message}`));
    // 模型解析必须在 loader 构建之后：自定义 provider 需先经 loader 注册完毕才解析得到
    this.loader = await this._buildLoader();
    const m = resolveModel(this.modelRuntime, { logger: logPi });
    if (m) {
      this.model = m;
      logPi.info(`使用模型: ${this.model.id}`);
    }
    // 【启动后自动接续】改代码/watchdog/OOM 重启后，不应让用户再发一条消息才能把我叫醒。
    // 延后一点再跑：等 QQ 连接就绪、模型就位（否则 sendCustomMessage 发不出去）。
    this._scheduleRestartResume();
  }

  /** 延后触发一次「重启接续」（只跑一遍，不阻塞 init） */
  _scheduleRestartResume() {
    if (config.pi?.restartResume === false) return;
    const delay = Number(config.pi?.restartResumeDelayMs ?? 8000);
    setTimeout(() => {
      this._resumeAfterRestart().catch((e) => logPi.warn(`[boot] 自动接续失败: ${e?.message}`));
    }, Math.max(1000, delay)).unref?.();
  }

  /**
   * 由 chatKey 反推唤醒所需的会话上下文。
   * private:<qq> → 私聊，targetId=qq；group:<gid> → 群聊，targetId=gid。
   * selfId 取桥接对象里的自身账号（取不到也没关系，大多数链路不依赖它）。
   */
  _wakeCtxFromChatKey(chatKey, userId = "") {
    const s = String(chatKey ?? "");
    const i = s.indexOf(":");
    const kind = i >= 0 ? s.slice(0, i) : "private";
    const id = i >= 0 ? s.slice(i + 1) : s;
    const chatType = kind === "group" ? "group" : "private";
    return {
      chatType,
      targetId: id,
      selfId: this.bridge?.selfId ?? null,
      userName: null,
      userId: String(userId || id || ""),
      chatKey: s,
      currentSessionKey: s,
    };
  }

  /**
   * 重启后的自动接续（两件事）
   *  ① 报出「因重启而中断」的子任务（_subTasks 是内存 Map，重启即灭）
   *  ② 把「尾部未完成」的会话接上，注入一条自动恢复消息（triggerTurn 直接开新一轮）
   *
   * 【实测踩过的坑】第一版直接 sess.sendCustomMessage(..., {triggerTurn:true})，
   * 日志显示「已自动接续」但之后**没有任何 [turn] 开始** —— 回合根本没跑。
   * 原因：_wakeSubDone 是套在 runWithTurnCtx(ctx, ...) 里发的，这里漏了；
   * 没有会话上下文，triggerTurn 就石沉大海（用户那边表现为「重启后依旧死寂」）。
   */
  async _resumeAfterRestart() {
    const rr = await import("./restart-resume.mjs");
    const pend = rr.loadPendingSubs(SESSIONS_DIR);
    const ids = Object.keys(pend);
    if (ids.length) {
      logPi.info(`[boot] 发现 ${ids.length} 个被重启打断的子任务，逐一会话上报`);
      for (const id of ids) {
        const info = pend[id];
        if (!info?.chatKey) continue;
        try {
          // 【注意】_getSession() 返回的是会话**条目**（{key, session, ...}），
          // 不是会话本身 —— 必须在 .session 上调用 sendCustomMessage。
          // 首次实测就踩了：日志报 "sess.sendCustomMessage is not a function"。
          const entry = await this._getSession(info.chatKey, info.userId || "");
          const sess = entry?.session;
          if (!sess) { logPi.warn(`[boot] 中断子任务 ${id} 找不到会话，跳过`); continue; }
          const ictx = this._wakeCtxFromChatKey(info.chatKey, info.userId);
          const mins = Math.max(1, Math.round((Date.now() - Number(info.ts || Date.now())) / 60000));
          const msg = [
            `【子任务中断通知】taskId=${id}`,
            `状态：进程重启导致中断（不是超时，也不是失败）—— 它在跑的过程中 bridge 被重启了，任务没有继续。`,
            info.snippet ? `原任务摘要：${info.snippet}` : "",
            `派发时间距今约 ${mins} 分钟。执行痕迹已随进程丢失，需要重新派发。`,
            `\n（这是重启自动接续产生的通知，无需轮询。）`,
          ].filter(Boolean).join("\n");
          await runWithTurnCtx(ictx, async () => {
            await this._notifySession(sess, "subagent-done", msg);
          });
        } catch (e) {
          logPi.warn(`[boot] 上报中断子任务 ${id} 失败: ${e?.message}`);
        }
      }
      rr.savePendingSubs(SESSIONS_DIR, {});
    }

    const withinMs = Number(config.pi?.restartResumeWindowMs ?? 10 * 60 * 1000);
    const hits = rr.findInterrupted(SESSIONS_DIR, withinMs);
    // 【两手准备】
    //   ① 有尾部未完成的 → 逐条接续（它们确实被砍在半路）
    //   ② 没有 → 至少把「最新活动过的那一个」对话接回来。
    //      为什么要 ②：实测遇到「我先把收尾文本正常发出、进程才重启」的情况，
    //      尾部看起来完整，如果不补 ②，重启后依旧一片死寂，用户仍得手动发消息。
    if (!hits.length) {
      const last = rr.findLastActive(SESSIONS_DIR, withinMs);
      if (!last) {
        logPi.info(`[boot] 窗口 ${Math.round(withinMs / 60000)} 分钟内无活动会话，不接续`);
        return;
      }
      try {
        const entry = await this._getSession(last.chatKey, last.userId);
        const sess = entry?.session;
        if (!sess) { logPi.warn(`[boot] 接续会话 ${last.name} 找不到会话对象，跳过`); return; }
        const lctx = this._wakeCtxFromChatKey(last.chatKey, last.userId);
        const mins = Math.max(1, Math.round((Date.now() - last.mtimeMs) / 60000));
        const msg = [
          "【自动接续】进程刚重启完成，我回来了。",
          `最后一次活动距今约 ${mins} 分钟（会话 ${last.name}）。`,
          last.tail
            ? `检测到上一轮中断在「${last.tail.reason}」，请接着做完；`
            : "上一轮的回合已收尾，无需重做；",
          "请自查当前进度（日志 / 产物文件 / 子任务状态），有未完成的事就直接继续，没有就简单知会一声。",
        ].join("\n");
        await runWithTurnCtx(lctx, async () => {
          await this._notifySession(sess, "restart-resume", msg);
        });
        logPi.info(`[boot] 已自动接续最新活动会话 ${last.name}（${last.tail ? last.tail.reason : "回合已收尾"}）`);
      } catch (e) {
        logPi.warn(`[boot] 接续最新活动会话失败: ${e?.message}`);
      }
      return;
    }
    for (const h of hits) {
      try {
        // 同上：条目 → 会话，别在 entry 上调会话方法
        const entry = await this._getSession(h.chatKey, h.userId);
        const sess = entry?.session;
        if (!sess) { logPi.warn(`[boot] 接续会话 ${h.name} 找不到会话对象，跳过`); continue; }
        const hctx = this._wakeCtxFromChatKey(h.chatKey, h.userId);
        const msg = [
          "【自动接续】进程刚重启，上一轮工作被打断了。",
          `中断点：最后一条记录是「${h.reason}」（会话 ${h.name}）。`,
          "请先自查当前进度（看日志/产物文件/子任务状态），确认做到哪一步，然后接着把它做完；不要从头重来。",
        ].join("\n");
        await runWithTurnCtx(hctx, async () => {
          await this._notifySession(sess, "restart-resume", msg);
        });
        logPi.info(`[boot] 已自动接续会话 ${h.name}（${h.reason}）`);
      } catch (e) {
        logPi.warn(`[boot] 接续会话 ${h.name} 失败: ${e?.message}`);
      }
    }
  }

  /** 统一系统提示（纯约束式：无角色扮演，仅行为规则与边界）——从 prompt/agent/system.md 读取 */
  _systemPrompt() {
    // 全局静态 system prompt：PI2X 约束（2X 视角由 before_agent_start 按用户动态注入、紧跟其后、不进历史）
    let base = pSystemAgent();
    // 显式注入 skills 列表（不依赖 pi 原生渲染时序，SKILL.md 放对目录即自动收录）：
    // 从每个 skill 目录的 SKILL.md 提取 name 与首段描述，模型按描述选用后以 read 读取全文执行。
    const lines = [];
    try {
      if (fs.existsSync(SKILLS_DIR)) {
        for (const e of fs.readdirSync(SKILLS_DIR, { withFileTypes: true })) {
          if (!e.isDirectory()) continue;
          const file = path.join(SKILLS_DIR, e.name, "SKILL.md");
          if (!fs.existsSync(file)) continue;
          const raw = fs.readFileSync(file, "utf8").slice(0, 1200);
          const nameM = raw.match(/^name:\s*(.+)$/m);
          const descM = raw.match(/^description:\s*(.+)$/m);
          const name = (nameM ? nameM[1].trim() : e.name) || e.name;
          const desc = (descM ? descM[1].trim() : raw.replace(/^---[\s\S]*?---/, "").split(/\n+/).find((l) => l.trim()) || "");
          lines.push(`- ${name}：${desc}（用法见 ${path.join(SKILLS_DIR, e.name)}/SKILL.md，用 read 读取全文）`);
        }
      }
    } catch (err) {
      logSkills.warn(`注入失败: ${err?.message}`);
    }
    if (lines.length) base += "\n\n## 可用技能（skills）\n" + lines.join("\n");
    return base;
  }

  async _buildLoader() {
    // skill 经 pi 原生机制加载（additionalSkillPaths 指向 prompt/skills 下的子目录）；
    // 当前 qq-bot 的 SKILL.md 已并入 system.md 而删除，目录为空时返回空数组；后续添加新 skill 会被自动加载。
    const skillDirs = fs.existsSync(SKILLS_DIR)
      ? fs.readdirSync(SKILLS_DIR, { withFileTypes: true })
          .filter((e) => e.isDirectory())
          .map((e) => path.join(SKILLS_DIR, e.name))
      : [];
    // 兼容：scripts/ 下 xxx/SKILL.md 的 skill 也加载（工具/脚本同目录放 scripts 的习惯）
    const scriptSkills = path.join(ROOT, "scripts");
    if (fs.existsSync(scriptSkills)) {
      for (const e of fs.readdirSync(scriptSkills, { withFileTypes: true })) {
        if (e.isDirectory() && fs.existsSync(path.join(scriptSkills, e.name, "SKILL.md"))) {
          skillDirs.push(path.join(scriptSkills, e.name));
        }
      }
    }
    // 公共 2X 基座已并入全局静态 system prompt（_systemPrompt）。
    // 记忆注入：通过 before_agent_start 把“当前请求的记忆”临时并入 system prompt（不进会话历史），
    // 历史只保留干净的 user/assistant/tool 消息。
    const me = this;
    const loader = new DefaultResourceLoader({
      cwd: WORKSPACE,
      agentDir: AGENT_DIR,
      noExtensions: true,
      noSkills: false,
      noPromptTemplates: true,
      noThemes: true,
      noContextFiles: true,
      additionalSkillPaths: skillDirs,
      systemPrompt: this._systemPrompt(),
      extensionFactories: [
        async (pi) => {
          // pi-web-access：web_search / fetch_content / 视频理解（零配置：keyless DuckDuckGo + fallback 链）
          try {
            const webPkg = "/root/.pi/agent/npm/node_modules/pi-web-access";
            const idx = path.join(webPkg, "index.ts");
            if (fs.existsSync(idx)) {
              const { createRequire } = await import("node:module");
              // 以 pi-coding-agent 为基解析 jiti
              const req = createRequire(path.join(ROOT, "node_modules", "@earendil-works", "pi-coding-agent", "noop.cjs"));
              const jitiFactory = req("jiti");
              const jiti = (jitiFactory.default ?? jitiFactory)(path.join(webPkg, "loader.cjs"), {
                interopDefault: true,
                moduleCache: false,
              });
              const mod = jiti(idx);
              if (typeof mod?.default === "function") await mod.default(pi);
              logPi.info("pi-web-access 已加载（web_search/fetch_content）");
            }
          } catch (e) { logPi.warn(`pi-web-access 加载失败: ${e?.message}`); }
        },
        (pi) => {
          // before_agent_start：注入 2X 视角 + 记忆；同时（调试开关）dump 完整 LLM 上下文
          pi.on("before_agent_start", async (event, ctx) => {
            const me2 = me;
            // 1) 2X 视角：**统一人设**，一个文件对所有人生效
            //
            // 【为什么不再分 base / diff】原先拆成 2x-base.md（公共基座，所有人）+
            // 2x-diff-{admin,public}.md（按权限组二选一），再在代码里拼接。
            // 三层拼装带来的问题：改一句话要判断"该动哪个文件"，同一个意思容易在
            // 两个 diff 里各写一遍然后跑偏；而 base 与 diff 之间还会互相覆盖语气。
            // 现在合并为 prompt/context/2x.md 一个文件，人设的差异（如对管理员的称呼）
            // 直接写成人设内部的一句说明 —— 文件只有一个，读的人也只有一处。
            let add = "";
            try {
              const userId = (getTurnCtx() ?? me2?.ctx)?.userId;
              const persona = userId ? me2?._personaFor?.(userId) : null;
              // 人设必须走 loadPersona()（读 PERSONA_DIR）—— 不能用 loadPrompt("context", ...)：
              // 人设已迁到 private/persona/，在 private 布局下 loadPrompt 会 ENOENT
              // 而被下面的 catch 静默吞掉，导致「人设整段没注入」却无人察觉。
              if (persona?.promptFile) add += loadPersona(persona.promptFile);
              // 权限白名单（私聊专用，此处为空串则不加）：
              // 同一私聊对象的权限稳定 → 放在 system 里不破坏前缀缓存。
              const tc0 = (getTurnCtx() ?? me2?.ctx) ?? {};
              if (tc0.permBlockSys) add += "\n\n" + tc0.permBlockSys;
            } catch (e) {
              // 这里**必须出声**：此前静默吞掉 ENOENT，让人设丢失了整整一段时间没人发现。
              logPi.warn(`上下文注入失败（人设/权限块）：${e?.code ?? ""} ${e?.message ?? e}`);
            }
            // 调试：dump 调用 LLM 时的完整上下文（systemPrompt + 会话消息）
            if (process.env.PI2X_DUMP_LLM) {
              try {
                const allMsgs = [];
                if (event.systemPrompt) allMsgs.push({ role: "system", content: event.systemPrompt });
                if (add) allMsgs.push({ role: "system", content: add });
                // 从 sessionManager 读会话消息（用 compact-aware 的 buildSessionContext——只含压缩摘要+后续，非原始全量）
                try {
                  const sctx = ctx?.sessionManager?.buildSessionContext?.();
                  const msgs = sctx?.messages ?? [];
                  for (const m of msgs) {
                    const c = typeof m?.content === "string" ? m.content : JSON.stringify(m?.content ?? "");
                    allMsgs.push({ role: String(m?.role ?? "?" + (m?.compacted ? "(压缩)" : "")), content: String(c).slice(0, 8000) });
                  }
                } catch {}
                const dir = path.join(ROOT, "tmp", "llm-requests");
                fs.mkdirSync(dir, { recursive: true });
                const ts = new Date().toISOString().replace(/[:.]/g, "-");
                const text = allMsgs
                  .map((m) => `===== ${m.role} =====\n${m.content.slice(0, 9000)}`)
                  .join("\n\n");
                fs.writeFileSync(path.join(dir, `req-${ts}.txt`), text, "utf8");
              } catch (e) { /* dump 失败不影响主流程 */ }
            }
            if (!add) return undefined;
            return { systemPrompt: event.systemPrompt + "\n\n" + add };
          });

          // ── 合并压缩（A1）：一次调用同时产出「摘要」与「长期事实」──────────────
          //
          // 【为什么合并】压缩与收割面对的是同一段消息 —— 压缩把它压成摘要，
          // 收割从中抽出值得长期记住的事实。分开跑就是同一段内容读两遍、
          // 两次 LLM 调用，而且各自理解一遍：摘要里提到的事实在收割那边可能被漏掉。
          //
          // 【怎么接管】pi 允许扩展用 `session_before_compact` 钩子接管整次压缩：
          // 我们返回 { compaction: {summary, firstKeptEntryId, tokensBefore} } 即可，
          // pi 就不再自己调摘要模型。这里拿到 preparation.messagesToSummarize
          // —— **恰好等于即将被丢弃的那段**，比自己拼上下文更准。
          //
          // 【失败必须回退】pi 的硬规则：摘要被 token 上限截断（stopReason==="length"）
          // 就判定「摘要不完整」并**放弃整次压缩**，历史一条不少、外部看只是"没反应"。
          // 合并后输出变多、撞上限概率上升，所以任何拿不准的情形都**不接管**，
          // 让 pi 走它自己的标准摘要 —— 宁可不合并，也不能赔上整次压缩。
          pi.on("session_before_compact", async (event, ctx) => {
            try {
              if (!mergeEnabled()) return undefined;
              const prep = event?.preparation;
              const msgs = prep?.messagesToSummarize;
              if (!Array.isArray(msgs) || !msgs.length) return undefined; // 没东西可压，交给 pi
              // entry：闲置压缩（每分钟巡检）**不在任何轮次上下文里**，
              // getTurnCtx() 会是 null —— 而记忆写入必须知道 userId/chatType/targetId。
              // entry 上存着这三要素（构造会话时记下），所以从这里取，不依赖轮次上下文。
              const entry = me?.sessions?.get?.(event?.sessionKey ?? "") ?? me?._compactEntryHint ?? null;
              const built = await me?._buildMergedCompaction?.({ prep, ctx, event, entry });
              if (!built) return undefined; // 任何不确定 → 不接管
              return { compaction: built.compaction };
            } catch (e) {
              logPi.warn(`合并压缩失败，回退 pi 标准摘要: ${e?.message}`);
              return undefined; // 绝不抛出去（钩子异常会连累整次压缩）
            }
          });
        },
        // 每请求临时块（权限白名单 / 风险研判 / 记忆）—— 挂在报文最后一条消息的末尾
        //
        // 【为什么是这个钩子，而不是 system prompt 或 context 事件】（都有实测依据）
        //
        // 1) 为什么不放 system prompt：前缀缓存 = 「从第 0 个 token 起的最长公共前缀」，
        //    system 里任何位置一变，分叉点之后全部作废。而记忆检索结果每轮都在变，
        //    放 system 末尾 = 每轮都把整段历史缓存清空。
        //      实测：同一 system + 历史，动态块放 system 末尾 → 命中 29%；
        //            改挂消息末尾 → 命中 97%。
        //      生产佐证：连续两次调用 system 末尾的记忆块换了内容，命中从 99% 掉到 6%
        //            （只剩 system 头部那 ~2560 token 命中）。
        //
        // 2) 为什么不用 context 事件（transformContext）：实测它的改写会被写回会话状态，
        //    于是临时块照样落盘 —— 不满足「不进历史」。见 tmp/ctxhook*.mjs 的对照验证。
        //
        // 3) before_provider_request 在报文序列化之后、真正发请求之前触发，改的是线上报文，
        //    **不经过会话状态**。实测：payload 里有、会话文件里没有 → 既不持久化，也不碰缓存前缀。
        (pi) => {
          pi.on("before_provider_request", async (event) => {
            // ① 注入临时块
            try {
              const tc = (getTurnCtx() ?? me?.ctx) ?? {};
              // 判断这是「用户对话轮」还是「工具轮」。
              //
              // 【为什么记忆只在用户轮注入】一个用户轮内部可能触发多次模型调用：
              //   用户提问 → 模型要调工具 → 工具结果回来 → 模型继续 …… 直到给出答复。
              // 只有**第一次**（报文最后一条是 user）才是"用户刚说完话"。
              // 后续几次最后一条是 tool，属于同一轮的延续 —— 记忆在轮首已经给过了，
              // 再塞一遍是纯浪费：实测最近 62 次工具轮里有 30 次带着整块记忆，
              // 每次都白占上千 token，且每轮都要覆盖报文尾部（影响缓存复用）。
              const payloadMsgs = Array.isArray(event?.payload)
                ? event.payload
                : Array.isArray(event?.payload?.messages) ? event.payload.messages : [];
              const lastRole = payloadMsgs[payloadMsgs.length - 1]?.role;
              const isUserTurn = lastRole === "user";
              // permBlockTail 只在群聊下有值（私聊的白名单已并入 system prompt）；
              // riskNote 是当次请求的风险结论，属"每请求有效"所以每次都带。
              const blocks = [
                // 【只在最新一轮（用户刚说完话的那一次模型调用）注入】
                // 一个用户轮内部会触发多次模型调用（模型→工具→模型→…）。
                // permBlockTail 的内容整轮不变，后续每次工具轮再塞一遍是纯浪费，
                // 且每次都在改写报文尾部、压低缓存复用。用 isUserTurn 卡住，
                // 保证它只出现在「最新一轮对话」的那一份请求里。
                isUserTurn ? tc.permBlockTail : "",
                tc.riskNote,
                isUserTurn ? tc.memInjection : "",
              ].filter(Boolean);
              if (blocks.length) {
                // 【必须包边界】这些块是我们自己塞的，不是用户说的话。不包边界时它们与
                // 用户原话在同一段文本里、排版也一样，模型会把块内容当成用户发言
                // （2026-09-14 实测：连续几次凭空“引用”不存在的用户消息）。
                // wrapInjected 加首尾机器标记，边界成为结构性事实，不可能看错。
                const ok = appendTailBlock(event?.payload, wrapInjected(blocks.join("\n\n")));
                if (!ok) logPi.warn("临时块注入失败（报文结构不符合预期）");
              }
            } catch (e) { logPi.warn(`临时块注入异常: ${e?.message}`); }
            // ②（可选）dump：放在注入之后，dump 出来的就是真正发出去的内容
            if (!process.env.PI2X_DUMP_LLM) return event?.payload;
            try {
              const dir = path.join(ROOT, "tmp", "llm-requests");
              fs.mkdirSync(dir, { recursive: true });
              const ts = new Date().toISOString().replace(/[:.]/g, "-");
              const p = path.join(dir, `req-${ts}.txt`);
              const payload = event?.payload;
              const src = Array.isArray(payload)
                ? payload.map((m) => `===== ${m?.role ?? "?"} =====\n` + String(m?.content ?? "")).join("\n\n")
                : JSON.stringify(payload, null, 2);
              fs.writeFileSync(p, src, "utf8");
            } catch (e) { /* dump 失败不影响主流程 */ }
            return event?.payload;
          });
        },
      ],
    });
    return loader.reload().then(() => loader);
  }

  _safeKey(chatKey) {
    return chatKey.replace(/[^a-zA-Z0-9_-]/g, "_");
  }

  _isStreaming(cm) {
    return cm?.session?.isStreaming ?? false;
  }

  /**
   * 把一条系统消息送给会话，并确保「真的把 agent 叫醒」。
   *
   * 【这是全案的关键坑】SDK 的 sendCustomMessage 实现里：
   *     if (options?.deliverAs === "nextTurn") { this._pendingNextTurnMessages.push(...) }
   *     else if (this.isStreaming && options?.triggerTurn !== false) { ... }
   *     else if (options?.triggerTurn) { ...开新一轮... }
   * 第一分支**直接入队并结束**，后面的 triggerTurn 根本不会求值。
   * 所以「triggerTurn:true + deliverAs:"nextTurn"」= 只入队、永不唤醒 ——
   * 表现就是通知一直躺着，直到用户下一条消息才被顺带投递，
   * 看起来就像「用户问了它才动」（用户实测原话：为什么我问你了你才开始）。
   * 子代理完成通知、子代理汇报、重启自动接续全部踩了这个坑，这里统一收口。
   *
   * 正确姿势：
   *   - 正在流式 → deliverAs:"steer"，注入当前回合（立即被感知，不打断）
   *   - 空闲     → 只传 triggerTurn:true，**绝不带 deliverAs**，才会真正开新一轮
   */
  async _notifySession(sess, customType, content) {
    if (!sess) return false;
    const { pickNotifyOptions } = await import("./restart-resume.mjs");
    await sess.sendCustomMessage(
      { customType, content, display: true },
      pickNotifyOptions(!!sess.isStreaming),
    );
    return true;
  }

  /** 调用 Windows 上配置好的 pi（subagent，print 模式）——Windows 优先
   * @param {string} task
   * @param {number} timeoutSec
   * @param {AbortSignal} [outSignal] 外部中止信号（/stop） */
  async _runWinPi(task, timeoutSec = 240, outSignal) {
    const ws = config.winShell;
    if (!ws?.enabled || !ws?.token) throw new Error("winShell 未配置");
    const resp = await winHost.fetch("/pi/run", {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${ws.token}` },
      body: JSON.stringify({ task: String(task), timeout: timeoutSec, model: this.model?.id }),
      signal: outSignal,
      timeoutMs: (timeoutSec + 30) * 1000,
    });
    const d = await resp.json().catch(() => ({}));
    if (!resp.ok) throw new Error(`win-pi HTTP ${resp.status}: ${d?.error ?? ""}`);
    const out = String(d?.stdout ?? "");
    if (!out && (d?.exitCode ?? 0) !== 0) throw new Error(`win-pi exit=${d?.exitCode} stderr=${String(d?.stderr ?? "").slice(0, 200)}`);
    return out || "（Windows pi 无输出）";
  }

  /** 纯异步：子任务后台运行，主 agent 可随时 steer / 取结果。
   * 安全：按发起者权限分级——仅全权用户（admin）的子代理可走 Windows；
   * 沙箱用户（operator）强制 Linux bwrap 沙箱（禁内置 bash/文件工具），防逃逸。
   * 运行位置由 config.pi.subagentRunner 决定（auto/win/linux）。 */
  async _startSubAsync(task, taskText, timeoutSec) {
    task.status = "running";
    const ownerPerms = task.ownerPerms ?? new Set();
    const canWin = ownerPerms.has("files:full") || ownerPerms.has("tools.windows_shell") || ownerPerms.has("tools.win_file_get");
    // 运行位置模式：
    //   linux —— **永远不走 Windows**。用户明确要求过两次（子任务的路径参数是 Linux 路径，
    //            Windows 那边看不到文件，结果就是子任务秒退且无输出，白烧一轮）。
    //   win   —— 强制 Windows，不可用直接报错（不静默回退，避免“以为跑了 win 其实跑了 linux”）。
    //   auto  —— 旧行为：Windows 优先，失败回退 Linux。
    const runner = String(config.pi?.subagentRunner ?? "auto").toLowerCase();
    if (canWin && runner !== "linux") {
      try {
        const tid = await this._startWinSubAsync(task, taskText, timeoutSec);
        if (tid) { task.type = "win"; return; }
      } catch (e) {
        if (runner === "win") {
          task.status = "failed";
          task.error = `已强制 Windows 但不可用: ${e?.message}`;
          this._wakeSubDone(task).catch((er) => logSub.warn(`唤醒异常: ${er?.message}`));
          return;
        }
        logSub.warn(`Windows 不可用，Linux 回退: ${e?.message}`);
      }
    } else if (runner === "linux") {
      logSub.info(`按 subagentRunner=linux 跳过 Windows，直接本机执行`);
    }
    // Linux 后台子 agent
    task.type = "linux";
    const cap = subTimeoutCap(timeoutSec);
    const file = path.join(SESSIONS_DIR, `subtask-${task.id}-${Math.random().toString(36).slice(2, 7)}.jsonl`);
    let session;
    try {
      const opts = {
        cwd: WORKSPACE,
        agentDir: AGENT_DIR,
        resourceLoader: this.loader,
        sessionManager: SessionManager.open(file),
        settingsManager: makeSettingsManager(),
        modelRuntime: this.modelRuntime,
        model: this.model,
        customTools: [
          // 传 ownerPerms（发起者的权限），而不是空集。
          //
          // 【原先传 new Set() 的后果】权限门禁 guard 一律拒绝：子代理调任何自定义工具
          // 都拿到「权限不足」，等于子代理的自定义能力全废（实测 save_memory / run_task
          // 均被拒）。子代理本就该以发起者身份行事 —— 降权只会让它寸步难行，
          // 而不是更安全（沙箱用户另有下面的 bwrap 分支兜底）。
          ...this._buildTools(ownerPerms, task.ownerUserId ?? "subagent").filter((t) => t.name !== "run_task" && t.name !== "subagent_send" && t.name !== "subagent_result"),
          // subagent 专用：主动向主 agent 汇报（写入主 agent 会话 + **唤醒**）
          defineTool({
            name: "subagent_report",
            ...pTool("subagent_report"),
            parameters: Type.Object({ message: Type.String({ description: "要汇报/发给主 agent 的消息内容" }) }),
            execute: async (_id, params) => {
              const ms = task.mainSession;
              if (!ms) return { content: [{ type: "text", text: "（无可汇报的主 agent 会话）" }], details: {} };
              try {
                // 【为什么必须带 triggerTurn】
                // 原先只传 deliverAs:"nextTurn"。SDK 的语义是把它推进 _pendingNextTurnMessages，
                // 只在**下一次 _runAgentPrompt** 时才并进消息里（agent-session.js:910）。
                // 主 agent 此刻若已空闲，就永远等不到「下一次」——汇报石沉大海，
                // 于是只能靠主 agent 反复轮询 subagent_result。
                // triggerTurn:true 在空闲时直接开新一轮，流式中则作为 steer 注入当前回合，
                // 两种情况主 agent 都能立即感知。
                // 【叫醒姿势】见 _notifySession 的注释：空闲时必须只传 triggerTurn，
                // 绝不能带 deliverAs:"nextTurn"（会直接入队、永不唤醒）。
                await this._notifySession(ms, "subagent-report", params.message);
                return { content: [{ type: "text", text: `已汇报给主 agent：${String(params.message).slice(0, 120)}` }], details: {} };
              } catch (e) {
                return { content: [{ type: "text", text: `汇报失败: ${e?.message}` }], details: {} };
              }
            },
          }),
        ],
      };
      // 沙箱用户（operator）的子代理：禁内置 read/bash/edit/write 全权工具，改用 bwrap 沙箱版本（防逃逸）
      if (ownerPerms.has("files") && !ownerPerms.has("files:full")) {
        opts.excludedToolNames = ["read", "bash", "edit", "write"];
        opts.customTools = [...this._sandboxFileTools(ownerPerms, task.ownerUserId ?? "?"), ...opts.customTools];
      }
      const { session: s } = await createAgentSession(opts);
      session = s;
      applyThinkingLevel(session); // 强制思考等级（覆盖会话里持久化的旧值）
      task.session = session;
      this._activeSubSessions.add(session); // /stop 可中止
      // 订阅增量输出
      // 工具调用足迹：只累积 reply（文本增量）是不够的 ——
      // 很多子任务**全程只调工具、一句正文都不说**，于是 reply 恒为空字符串，
      // 超时/失败时通知里就只剩「未产生文本输出」，等于静默超时（用户实测踩过）。
      // 这里把每条消息里的工具调用也记下来，供结束时拼摘要。
      task.toolLog = [];
      task.unsub = session.subscribe((ev) => {
        if (ev.type === "message_update" && ev.assistantMessageEvent?.type === "text_delta") {
          task.reply += ev.assistantMessageEvent.delta ?? "";
        } else if (ev.type === "message_end") {
          const content = ev.message?.content;
          if (Array.isArray(content)) {
            for (const seg of content) {
              if (seg?.type !== "toolCall") continue;
              const a = seg.arguments ?? {};
              const brief = String(a.command ?? a.path ?? a.task ?? a.message ?? "").replace(/\s+/g, " ").slice(0, 120);
              const n = task.toolLog.length + 1;
              task.toolLog.push(`${seg.name}${brief ? ": " + brief : ""}`);
              // 【实时日志】只打前 5 次 + 每 10 次的里程碑。
              // 有了它，子任务卡住时能从 bridge.log 直接看出它卡在哪一步，
              // 不用等 30 分钟超时、也不会再出现「整场只有 start/done 两行」的黑盒。
              if (n <= 5 || n % 10 === 0) {
                logSub.info(`子任务 ${task.id} 第 ${n} 次工具调用 ${seg.name}${brief ? " · " + brief : ""}`);
              }
            }
            // 只留最近 20 条，避免长任务把内存吃满
            if (task.toolLog.length > 20) task.toolLog = task.toolLog.slice(-20);
          }
        } else if (ev.type === "agent_settled") {
          // 【不要在收尾事件里无条件覆盖状态】
          // 实测踩过的坑：子任务撞满超时后，race 分支已把 status 置为 failed、error 置为「超时」；
          // 但被 abort 的子会话随后仍会抛出 agent_settled，于是状态被改回 done
          // → finally 里「只有 done 才删档」的判断成立 → 执行记录被 unlink，
          // 主 agent 收到的通知只有「完成 / 未产生文本输出」，事后无从追溯（30 分钟白烧）。
          // 现在：已经定性的终态（failed/aborted/done）一律不再改写。
          if (task.status === "running" || task.status === "pending") task.status = "done";
        }
      });
      // 后台启动（不 await 完成），超时/中止由 sig 控制
      const timeoutP = new Promise((_, rej) => setTimeout(() => rej(new Error("超时")), cap * 1000).unref?.());
      const abortP = task.sig ? new Promise((_, rej) => task.sig.addEventListener("abort", () => rej(new Error("已中止")), { once: true })) : null;
      session.prompt(taskText, { streamingBehavior: "followUp" })
        .then(() => {
          // agent_settled 已把状态置为 done；这里兼容它未触发的情况
          if (task.status === "running" || task.status === "pending") task.status = "done";
        })
        .catch((e) => {
          // abort 分支的信号是 “已中止”，不要再带 error 吓人
          if (task.sig?.aborted) { task.status = "aborted"; task.error = ""; }
          else { task.status = "failed"; task.error = e?.message || String(e); }
        })
        .finally(() => {
          try { task.unsub?.(); } catch {}
          try { session.dispose(); } catch {}
          this._activeSubSessions.delete(session);
          // 【异常结束必须留档】原先无论成败都 unlink，超时的子任务连「它干过什么」都查不到，
          // 主 agent 那边就只看到一句「未产生文本输出」—— 典型的静默超时。
          // 正常完成才删；异常（超时/中止/失败）把执行记录挪进 sessions/subagent-archive/ 留档，
          // 路径会写进唤醒通知，事后可以翻回去接着做。
          // timedOut 是「已定性」的硬标记：即使某些极端时序下 status 被写回 done，
          // 也必须留档，绝不能把执行痕迹删掉。
          if (task.status === "done" && !task.timedOut) {
            try { fs.unlinkSync(file); } catch {}
          } else {
            try {
              const archDir = path.join(SESSIONS_DIR, "subagent-archive");
              fs.mkdirSync(archDir, { recursive: true });
              const dest = path.join(archDir, path.basename(file));
              fs.renameSync(file, dest);
              task.transcript = dest;
              logSub.info(`子任务 ${task.id} ${task.status}，执行记录已留档: ${dest}`);
            } catch (e) {
              logSub.warn(`留档失败: ${e?.message}`);
            }
          }
          // 完成唤醒：子任务结束（成功/失败/中止）→ 主动通知主 agent
          this._wakeSubDone(task).catch((e) => logSub.warn(`唤醒异常: ${e?.message}`));
        });
      Promise.race([timeoutP, abortP].filter(Boolean)).catch((e) => {
        // 【先打标记再定性】timedOut 一旦置位，后续任何收尾事件都不得把状态改回 done。
        // 这样 finally 的留档分支才可靠（超时/中止的执行记录会被挪进 subagent-archive/）。
        const isAbort = !!task.sig?.aborted;
        if (!isAbort) task.timedOut = true;
        if (task.status === "running" || task.status === "pending") {
          task.status = isAbort ? "aborted" : "failed";
          task.error = isAbort ? "" : (e?.message || String(e));
          logSub.warn(`子任务 ${task.id} ${task.status}${task.error ? "/" + task.error : ""}（用时已达上限），即将留档`);
        }
        try { session?.abort?.().catch(() => {}); } catch {}
      });
    } catch (e) {
      task.status = "failed";
      task.error = e?.message || String(e);
      try { session?.dispose(); } catch {}
      this._activeSubSessions.delete(session);
      // 会话创建失败也要删掉占位文件，否则会留下空文件（原先漏了这一步）
      try { fs.unlinkSync(file); } catch {}
      // 启动就失败：同样要唤醒主 agent（否则它会一直等一个永远不会完成的任务）
      this._wakeSubDone(task).catch((er) => logSub.warn(`唤醒异常: ${er?.message}`));
    }
  }

  /**
   * 子任务结束后的「完成唤醒」——本机制的核心。
   *
   * 【要解决的问题】
   * run_task 派发后立即返回 taskId。若子任务完成时**不主动唤醒**主 agent，
   * 主 agent 只能靠反复调 subagent_result 轮询——而每一轮轮询都是一次完整的
   * LLM 请求（system + 全部历史 + 工具返回），几十秒一次、持续十几分钟，
   * 上下文与 token 成本都极高，且子任务实际已完成也无人知晓。
   *
   * 【做法】把「等待」从 LLM 层下沉到代码层：
   *   代码后台等子任务结束 → 结束时把结果作为一条消息写回主会话。
   *   主会话空闲 → triggerTurn 开新一轮（真正唤醒）；
   *   主会话忙繩 → 按 steer 注入当前回合并被感知（不打断）。
   * 这样主 agent 一次派发后就可以正常结束回合，上下文不再因轮询而膨胀。
   *
   * @param {object} task _subTasks 里的任务对象
   * @param {{status?:string, error?:string}} [extra] 额外状态（win 轮询路径传入）
   */
  async _wakeSubDone(task, extra = {}) {
    if (!task || task.woken) return;   // 幂等：一个子任务只唤醒一次
    task.woken = true;
    // 【销账】子任务已有终局（无论成败），把启动时落盘的 pending 记录删掉，
    // 免得下次重启把它当成「被重启打断的任务」再报一遍。
    try {
      const { clearPendingSub } = await import("./restart-resume.mjs");
      clearPendingSub(SESSIONS_DIR, task.id);
    } catch { /* 销账失败不影响通知 */ }
    const st = extra.status ?? task.status ?? "done";
    const err = extra.error ?? task.error ?? "";
    const reply = String(task.reply ?? "").trim();
    // 【未产生文本输出 ≠ 什么都没做】很多子任务全程只调工具、不输出正文，
    // 一旦超时，旧版通知就只剩一句「（子任务完成，但未产生文本输出）」+「超时」，
    // 过程完全不可见 —— 用户明确指出这叫静默超时。
    // 这里补两样：① 它最后做过的工具调用；② 留档的执行记录路径。
    // 【只要没有正文，就必须附上过程】
    // 原先的条件是 `!reply && st !== "done"`，结果状态被错误写成 done 时
    // 连工具足迹一起吞了 —— 主 agent 只能看到一句「未产生文本输出」。
    // 空正文 + done 同样不可接受（干了活却什么都没交代）。
    if (!reply) {
      const tl = Array.isArray(task.toolLog) ? task.toolLog : [];
      const tail = tl.slice(-8);
      if (tail.length) {
        digest += `\n最后做过的操作（全程共 ${tl.length} 次工具调用）：\n` + tail.map((x) => `  · ${x}`).join("\n");
      } else {
        digest += `\n（全程没有任何工具调用 —— 说明它连第一步都没动，多半是任务描述或运行环境有问题）`;
      }
      if (task.transcript) {
        digest += `\n完整执行记录已留档：${task.transcript}\n（需要的话让我读这个文件，可以恢复它做到哪一步、接着往下做）`;
      }
    }
    // 唤醒正文：把结果直接附上，主 agent 不需要再去查一次
    const head = `【子任务完成通知】taskId=${String(task.id)}\n状态：${st}`;
    const body = reply
      ? `\n输出：\n${reply.slice(0, config.tools.resultMaxChars)}`
      : (st === "done" ? "\n输出：（子任务完成，但未产生文本输出）" : "");
    const tail = err ? `\n错误：${String(err).slice(0, 800)}` : "";
    const msg = `${head}${body}${digest}${tail}\n\n（这是系统自动推送的完成通知，不需轮询；请直接根据上述结果继续处理未完成的工作。）`;
    const entry = this._findEntryByTask(task);
    const sess = entry?.session ?? task.mainSession;
    if (!sess) {
      logSub.warn(`子任务 ${task.id} 已完成，但找不到主会话，无法唤醒（结果已保留在 _subTasks）`);
      return;
    }
    try {
      // 唤醒必须在**正确的会话上下文**里发出（否则 QQ 推送/记忆来源会串）。
      // 用派发时快照的 wakeCtx——此刻已脱离原回合的 ALS 作用域。
      const wc = task.wakeCtx ?? {};
      const ctx = {
        chatType: wc.chatType ?? "private",
        targetId: wc.targetId,
        selfId: wc.selfId ?? null,
        userName: wc.userName ?? null,
        userId: wc.userId ?? task.ownerUserId ?? "",
        chatKey: wc.chatKey,
        currentSessionKey: entry?.key ?? wc.chatKey,
      };
      // 唤醒时也要把回复流式发给用户（若这轮产生新输出）
      const streamSend = config.pi?.streamReplies === false
        ? null
        : async (part) => {
            const t = String(part ?? "").trim();
            if (!t) return;
            const ctype = ctx.chatType;
            const tid = ctx.targetId;
            try {
              if (ctype === "group") await this.bridge.sendGroupMsg(Number(tid), t);
              else await this.bridge.sendPrivateMsg(Number(tid), t);
            } catch (e) {
              logSub.warn(`唤醒流式发送失败: ${e?.message}`);
            }
          };
      await runWithTurnCtx(ctx, async () => {
        await this._notifySession(sess, "subagent-done", msg);
      });
      logSub.info(`子任务 ${task.id} 已${st}，已唤醒主 agent 处理（会话 ${ctx.chatKey}）`);
    } catch (e) {
      logSub.warn(`子任务 ${task.id} 唤醒失败: ${e?.message}`);
    }
  }

  /** 按 task 找到对应的主会话 entry（优先快照的 key，兼作兼容回退） */
  _findEntryByTask(task) {
    const k = task?.wakeCtx?.chatKey;
    if (!k) return null;
    const sk = sessionKeyOf(k, task.ownerUserId ?? "");
    return this.sessions?.get(sk) ?? this.sessions?.get(k) ?? null;
  }

  /** Windows 侧异步启动子任务。win-agent 若支持 taskId 维度可返回其 taskId；否则抛错。 */
  async _startWinSubAsync(task, taskText, timeoutSec) {
    const ws = config.winShell;
    if (!ws?.enabled || !ws?.token) throw new Error("winShell 未配置");
    const resp = await winHost.fetch("/pi/run", {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${ws.token}` },
      body: JSON.stringify({ task: String(taskText), timeout: Number(timeoutSec || 30), async: true, taskId: task.id, model: this.model?.id }),
    });
    const d = await resp.json().catch(() => ({}));
    if (!resp.ok) throw new Error(`win-pi HTTP ${resp.status}: ${d?.error ?? ""}`);
    if (d?.async === false) throw new Error("win-agent 不支持异步任务");
    task.winTaskId = d?.taskId ?? task.id;
    // 启动后台看护：**在代码层**轮询 /pi/status，一旦结束就唤醒主 agent。
    //
    // 【为何可以在这里轮询】真正的代价不在于「轮询」动作本身，而在于
    // 「让 LLM 发一轮请求去查」。这里每 N 秒发的是一个本地 HTTP 请求，
    // 不碰 LLM、不碰上下文，代价几乎为零；而主 agent 侧完全无需参与。
    this._watchWinSub(task, Number(timeoutSec || 30));
    return task.winTaskId;
  }

  /**
   * Windows 子任务看护：轮询 /pi/status，终态时唤醒主 agent。
   * 轮询完全在代码层，不消耗主 agent 上下文/token（与「LLM 反复调工具查」本质不同）。
   */
  _watchWinSub(task, timeoutSec) {
    const cap = subTimeoutCap(timeoutSec);
    const startedAt = Date.now();
    const INTERVAL = 3000;
    const tick = async () => {
      if (task.woken) return;                      // 已唤醒，停
      if (task.sig?.aborted) {                     // 被 /stop 中止
        task.status = "aborted";
        await this._wakeSubDone(task);
        return;
      }
      if (Date.now() - startedAt > cap * 1000 + 5000) {   // 超出预期时限（win 侧自己也有超时）
        if (task.status === "running" || task.status === "pending") {
          task.status = "failed";
          task.error = `超时（${cap}s）`;
        }
        await this._wakeSubDone(task);
        return;
      }
      try {
        const ws = config.winShell;
        const resp = await winHost.fetch("/pi/status", {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${ws.token}` },
          body: JSON.stringify({ taskId: task.winTaskId ?? task.id }),
          timeoutMs: 8000,
        });
        const d = await resp.json().catch(() => ({}));
        if (d?.text) task.reply = String(d.text);
        const st = String(d?.status ?? "");
        if (st && st !== "running" && st !== "pending") {
          task.status = st === "done" ? "done" : (st === "aborted" ? "aborted" : "failed");
          task.error = d?.error || "";
          await this._wakeSubDone(task);
          return;
        }
        if (d?.error && /不存在/.test(String(d.error))) {   // 任务丢了（win 侧重启等）
          task.status = "failed";
          task.error = String(d.error);
          await this._wakeSubDone(task);
          return;
        }
      } catch (e) {
        // 单次查询失败不致命（网络抖动/主机切换），下个周期再试
        logSub.debug(`win 子任务状态查询失败: ${e?.message}`);
      }
      task.winTimer = setTimeout(() => { tick().catch(() => {}); }, INTERVAL);
      task.winTimer.unref?.();
    };
    task.winTimer = setTimeout(() => { tick().catch(() => {}); }, INTERVAL);
    task.winTimer.unref?.();
  }

  /** 向子任务插话（steer）：Linux 用 session.steer；Windows 调 reach 的 /pi/steer */
  async _subSteer(task, message) {
    if (task.type === "linux" && task.session) {
      await task.session.steer(message);
      return;
    }
    if (task.type === "win" || task.winTaskId) {
      const ws = config.winShell;
      const resp = await winHost.fetch("/pi/steer", {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${ws.token}` },
        body: JSON.stringify({ taskId: task.winTaskId ?? task.id, message }),
      });
      const d = await resp.json().catch(() => ({}));
      if (!resp.ok) throw new Error(`win steer HTTP ${resp.status}: ${d?.error ?? ""}`);
      return;
    }
    throw new Error("子任务未处于可插话状态");
  }

  /**
   * 确保 headless Chrome 实例可用。
   *
   * 【两个实例，按使用者隔离凭据】
   *   9222 = 管理员实例，profile `browser-profile`（含 admin 登录态）
   *   9223 = 普通用户/operator 实例，profile `browser-profile-op`（全新，**不含** admin 凭据）
   *
   * 【为什么两个都要在这里常驻启动】
   * 原先只自启 9222。operator 在沙盒里自己跑 browser-cli 时，既找不到 Chrome 二进制
   * （沙盒是白名单挂载），也无法 detach 一个长驻进程（bwrap --die-with-parent）。
   * 现在由主进程统一把两个实例拉起来，沙盒内的 CLI 只需通过 CDP 连 localhost 使用。
   * 附带好处：profile 目录留在沙盒外，operator 改不到自己的浏览器凭据文件。
   *
   * @param {number} port 9222 | 9223
   */
  async _ensureChromeOne(port) {
    const { spawn } = await import("node:child_process");
    const fs2 = await import("node:fs");
    const findBin = () => {
      const base = "/root/.cache/ms-playwright";
      if (!fs2.existsSync(base)) return null;
      try {
        for (const d of fs2.readdirSync(base)) {
          const p = `${base}/${d}/chrome-linux-arm64/chrome`;
          const p2 = `${base}/${d}/headless_shell`;
          if (fs2.existsSync(p)) return p;
          if (fs2.existsSync(p2)) return p2;
        }
      } catch {
        return null;
      }
      return null;
    };
    const up = async () => {
      try {
        const r = await fetch(`http://127.0.0.1:${port}/json/version`, { signal: AbortSignal.timeout(1200) });
        return r.ok;
      } catch {
        return false;
      }
    };
    if (await up()) return true;
    const bin = findBin();
    if (!bin) {
      logBrowser.warn(`未找到 chrome 二进制（playwright 未下载），浏览器 skill 不可用（:${port}）`);
      return false;
    }
    const profile = port === 9222 ? BROWSER_PROFILE_DIR : BROWSER_PROFILE_OP_DIR;
    try {
      fs2.mkdirSync(profile, { recursive: true, mode: 0o700 });
    } catch {
      /* ignore */
    }
    // 清掉陈旧锁文件：上一个 Chrome 被 kill（重启/超时）时会留下 Singleton*，
    // 新实例可能因此拒绝启动 —— 表现为「端口迟迟不监听」，但手动删锁后立刻就好。
    // 只有在确认该端口没有实例在跑时才清（上面已 await up() 判过），安全。
    for (const f of ["SingletonLock", "SingletonCookie", "SingletonSocket"]) {
      try {
        fs2.rmSync(path.join(profile, f), { force: true });
      } catch {
        /* ignore */
      }
    }
    try {
      spawn(
        bin,
        [
          "--headless=new",
          "--no-sandbox",
          "--disable-gpu",
          "--disable-dev-shm-usage",
          `--remote-debugging-port=${port}`,
          "--user-data-dir=" + profile,
          "--window-size=1280,900",
          "--hide-scrollbars",
          "about:blank",
        ],
        { detached: true, stdio: "ignore" }
      ).unref();
      // 等它真的起来再返回，避免「刚启动就被调用」的竞态
      for (let i = 0; i < 20; i++) {
        await new Promise((r) => setTimeout(r, 400));
        if (await up()) {
          logBrowser.info(`headless Chrome 已启动（:${port}${port === 9223 ? " · operator 隔离实例" : ""}）`);
          return true;
        }
      }
      logBrowser.warn(`Chrome 启动后未就绪（:${port}）`);
      return false;
    } catch (e) {
      logBrowser.warn(`chrome 启动失败（:${port}）: ${e?.message}`);
      return false;
    }
  }

  /** 创建独立子 agent 执行复杂任务（subagent）
   * 环境：优先 Windows pi（用户已配置专属工具）；Windows 不可达/失败 → 本机 Linux 子 agent 回退 */
  async _runSubAgent(task, timeoutSec = 240, outSignal) {
    const cap = subTimeoutCap(timeoutSec);
    const file = path.join(SESSIONS_DIR, `subagent-${Date.now()}-${Math.random().toString(36).slice(2, 7)}.jsonl`);
    let session;
    try {
      // 先取发起者身份与权限：既要传给 _buildTools（否则子代理工具全被门禁拒），
      // 也用于下面判断是否走沙箱分支。
      const ownerId = this.ctx?.userId ?? "";
      const ownerPerms = this.white.perms(ownerId);
      const opts = {
        cwd: WORKSPACE,
        agentDir: AGENT_DIR,
        resourceLoader: this.loader,
        sessionManager: SessionManager.open(file),
        settingsManager: makeSettingsManager(),
        modelRuntime: this.modelRuntime,
        model: this.model,
        customTools: this._buildTools(ownerPerms, ownerId || "subagent").filter((t) => t.name !== "run_task"),
      };
      // 沙箱用户（operator）：子代理同样禁内置文件工具 + bwrap 沙箱（防逃逸）
      if (ownerPerms.has("files") && !ownerPerms.has("files:full")) {
        opts.excludedToolNames = ["read", "bash", "edit", "write"];
        opts.customTools = [...this._sandboxFileTools(ownerPerms, ownerId || "?"), ...opts.customTools];
      }
      const { session: s } = await createAgentSession(opts);
      session = s;
      applyThinkingLevel(session); // 强制思考等级（覆盖会话里持久化的旧值）
      this._activeSubSessions.add(session); // 注册，/stop 可中止
      logSub.info(`启动任务(${cap}s): ${String(task).slice(0, 60)}`);
      let reply = "";
      const unsub = session.subscribe((ev) => {
        if (ev.type === "message_update" && ev.assistantMessageEvent?.type === "text_delta") {
          reply += ev.assistantMessageEvent.delta;
        }
      });
      const timeoutP = new Promise((_, rej) => setTimeout(() => rej(new Error("超时")), cap * 1000).unref?.());
      const abortP = outSignal ? new Promise((_, rej) => outSignal.addEventListener("abort", () => rej(new Error("已中止")), { once: true })) : null;
      await Promise.race(abortP ? [session.prompt(task, { streamingBehavior: "followUp" }), timeoutP, abortP] : [session.prompt(task, { streamingBehavior: "followUp" }), timeoutP]);
      unsub();
      return reply || "（子任务无输出）";
    } finally {
      try { session?.dispose(); } catch {}
      this._activeSubSessions.delete(session);
      try { fs.unlinkSync(file); } catch {}
    }
  }

  /** 中止所有 subagent 任务（/stop）：Windows pi RPC abort + Linux 子会话 abort
   * @returns {number} 中止数量 */
  async _stopSubs() {
    let n = 0;
    if (this._subAbort && !this._subAbort.signal.aborted) {
      this._subAbort.abort();
      n++;
    }
    // Windows pi RPC 显式中止（让 win-agent 结束当前 prompt）
    const ws = config.winShell;
    if (ws?.enabled && ws?.token) {
      try {
        await winHost.fetch("/pi/abort", {
          method: "POST",
          headers: { Authorization: `Bearer ${ws.token}` },
          timeoutMs: 5000,
        }).catch(() => {});
      } catch {}
    }
    // 标记所有异步子任务为 aborted，并停止其会话
    for (const [tid, t] of this._subTasks) {
      if (t.status === "pending" || t.status === "running") {
        t.status = "aborted";
        try { t.winTimer && clearTimeout(t.winTimer); } catch {}
        try { t.sig?.abort?.(); } catch {}
        try { t.session?.abort?.().catch(() => {}); } catch {}
        // Windows 侧同步中止（异步看护会因状态变化自行停）
        const wcfg = config.winShell;
        if (t.winTaskId && wcfg?.enabled && wcfg?.token) {
          try {
            await winHost.fetch("/pi/abort", {
              method: "POST",
              headers: { "Content-Type": "application/json", Authorization: `Bearer ${wcfg.token}` },
              body: JSON.stringify({ taskId: t.winTaskId }),
              timeoutMs: 5000,
            }).catch(() => {});
          } catch {}
        }
        n++;
      }
    }
    // Linux 子会话 abort
    for (const s of [...this._activeSubSessions]) {
      try { await s.abort().catch(() => {}); } catch {}
      n++;
    }
    this._activeSubSessions.clear();
    return n;
  }

  /** 确保管理员与 operator 两个 Chrome 实例都可用（不阻塞主流程、逐个等待就绪） */
  async _ensureChrome() {
    try {
      await this._ensureChromeOne(9222);
      await this._ensureChromeOne(9223);
    } catch (e) {
      logBrowser.warn(`Chrome 自启异常: ${e?.message}`);
    }
  }

  /**
   * 选 bwrap 启动方式：能原生用就原生，受限内核下回退到垫片。
   *
   * 【为什么要探测】本机（安卓容器）根挂载点传播属性改不动，原生 bwrap 必挂；
   * 但换台正常 Linux 又不该被垫片裹着跑。探测结果缓存，每个进程只付一次代价
   * （最多 600ms，且只在第一次沙盒 bash 时发生）。
   *
   * 判据特意与失败点对齐：直接拿 bwrap 跑一条最小命令（它启动第一步就是
   * mount --make-slave /）。成则原生可用，败则回退垫片。
   * 不用 `mount --make-slave /` 去探测 —— 那在正常机器上会真的改掉本进程
   * 命名空间的根传播属性，探测动作不该有副作用。
   */
  async _bwrapLauncher() {
    if (this._bwrapLauncherCache) return this._bwrapLauncherCache;
    const { execFileSync } = await import("node:child_process");
    let ok = false;
    try {
      execFileSync("bwrap", ["--die-with-parent", "--ro-bind", "/usr", "/usr", "--symlink", "usr/bin", "/bin", "bash", "-c", "true"], {
        stdio: "ignore",
        timeout: 8000,
      });
      ok = true;
    } catch {
      ok = false;
    }
    this._bwrapLauncherCache = ok ? ["bwrap"] : ["bash", path.join(ROOT, "scripts", "bwrap-shim.sh")];
    if (!ok) logBrowser.info("根挂载点传播属性不可改（受限内核）→ 沙盒 bash 走 bwrap 垫片");
    return this._bwrapLauncherCache;
  }

  _sessionCwd(userId, perms) {
    if (perms.has("files:full")) return WORKSPACE;
    if (perms.has("files")) {
      const dir = path.join(this.sandboxRoot, String(userId));
      fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
      return dir;
    }
    return WORKSPACE;
  }

  /** 取（或创建）某个 chatKey 的 agent 会话（按白名单权限决定工具集）
   * 注：用 pending Map 去重，避免并发调用时对同一 chatKey 重复创建（会触发会话文件 wx 冲突 EEXIST） */
  async _getSession(chatKey, userId) {
    // 群会话按用户隔离：group:gid:userId（权限/上下文各自独立，避免跨用户串权限）
    const sessionKey = sessionKeyOf(chatKey, userId);
    const existing = this.sessions.get(sessionKey);
    if (existing) return existing;
    const pending = this._pending.get(sessionKey);
    if (pending) return pending;
    const p = this._createSession(sessionKey, userId)
      .then((entry) => {
        entry.key = sessionKey;
        this.sessions.set(sessionKey, entry);
        this._pending.delete(sessionKey);

        return entry;
      })
      .catch((err) => {
        this._pending.delete(sessionKey);
        throw err;
      });
    this._pending.set(sessionKey, p);
    return p;
  }

  async _createSession(chatKey, userId) {
    const perms = this.white.perms(userId);
    const file = path.join(SESSIONS_DIR, `${this._safeKey(chatKey)}.jsonl`);

    // 开卷先体检：历史里若有「孤儿 toolResult」（有结果、无调用），OpenAI 兼容接口会对
    // **整条请求**返回 400，此后每一轮都必然失败 —— 外部表现就是「模型永远返回空内容」，
    // bot 看起来死了，日志里却一条错误都没有（400 藏在 assistant 消息的 errorMessage 里）。
    //
    // 【代价与必要性】只在会话首次创建时跑一次，读一遍 jsonl；没有孤儿就立即返回，不写盘。
    // 换来的是「坏历史不可能把会话锁死」这个硬保证 —— 2026-10-22 那次为此白死了 3 天。
    try {
      const r = repairSessionFile(file, { fs });
      if (r.removed?.length) {
        logPi.warn(
          `${chatKey} 会话历史修复：剔除 ${r.removed.length} 条孤儿工具结果` +
            `（${r.removed.map((x) => x.toolName || x.toolCallId).join(", ")}）` +
            `${r.backup ? `，备份 ${path.basename(r.backup)}` : ""}`,
        );
      } else if (r.ok === false) {
        logPi.warn(`${chatKey} 会话历史修复失败: ${r.error}`);
      }
    } catch (e) {
      logPi.warn(`${chatKey} 会话历史体检异常: ${e?.message}`);
    }

    const opts = {
      cwd: this._sessionCwd(userId, perms),
      agentDir: AGENT_DIR,
      resourceLoader: this.loader,
      sessionManager: SessionManager.open(file),
      settingsManager: makeSettingsManager(),
      modelRuntime: this.modelRuntime,
      model: this.model,
    };
    const hasFilesFull = perms.has("files:full");
    const hasFiles = perms.has("files");
    const customTools = this._buildTools(perms, userId);
    if (hasFilesFull) {
      // 内置基础工具全开：bash/edit/write + ls/find/grep（SDK 默认只注册核心 4 件套，extra 经 customTools 补）；
      // read 换成「会压大图」的版本——见 READ_IMAGE_MAX_BYTES 处的说明（图片会长期占住每轮请求）。
      opts.excludedToolNames = ["read"];
      opts.customTools = [createReadToolShrinkingImages(opts.cwd), createLsTool(WORKSPACE), createFindTool(WORKSPACE), createGrepTool(WORKSPACE), ...customTools];
    } else if (hasFiles) {
      // 沙盒：内置文件工具替换为受限版（bwrap + 路径校验），自定义工具照常
      opts.excludedToolNames = ["read", "bash", "edit", "write"];
      opts.customTools = [...this._sandboxFileTools(perms, userId), ...customTools];
    } else {
      // 无文件权限：内置文件工具全禁（防 dialog 用户拿到内置 bash / 读写）。
      // 有其它权限 → 保留自定义工具（noTools="builtin" 只关内置的）；
      // 一个权限都没有（dialog）→ 用显式白名单只开 PUBLIC_TOOLS，
      // 不再用 noTools="all"（它会把扩展注册的 web_search 也一起关掉）。
      opts.noTools = "builtin"; // 禁内置 read/bash/edit/write/ls/find/grep
      // 一个权限都没有（dialog）：再用显式白名单把可用面收窄到 PUBLIC_TOOLS（含联网搜索）。
      // 有其它权限的组不放 tools，靠 customTools + 各工具的 TOOL_PERM 门禁照常运作。
      if (perms.size === 0) opts.tools = [...PUBLIC_TOOLS];
      opts.customTools = customTools;
    }
    const { session } = await createAgentSession(opts);
    applyThinkingLevel(session); // 强制思考等级（覆盖会话里持久化的旧值）
    const entry = {
      session,
      // 记忆来源标识：压缩时要在**丢弃历史之前**抽一次事实，
      // 而记忆写入必须用与检索端一致的来源键（见 lib/memory-source.mjs），
      // 所以这里把构造它所需的三要素连同会话一起记下来。
      chatKey,
      userId,
      chatType: chatKey.startsWith("group:") ? "group" : "private",
      targetId: chatKey.replace(/^(group|private):/, ""),
      tail: Promise.resolve(),
      context: null,
      asm: new TurnAssembler(session, { logger: logPi }),
      globalInjected: false, // 全局记忆只注入一次（首条消息），避免历史重复
      // 闲置计时起点 = **整轮全部完成**的时刻（含该轮内所有工具调用/子任务）。
      // 不取「最后一次 LLM 调用」：一轮里工具可能跑很久，中途每次 submit 都会刷新时间，
      // 那样算出来的"闲置"会偏短，且语义上也不是「整轮结束后经过多久」。
      lastTurnEndAt: Date.now(),
      turnRunning: false,    // 是否有轮次正在处理（含工具执行）—— 进行中绝不触发闲置压缩
    };
    logPi.info(`新会话 ${chatKey} [user ${userId}]
   权限: ${this.white.list(userId).join(", ") || "dialog(最低)"}`);
    return entry;
  }

  /** bot 专属工具（按白名单权限装载）
   * @param {Set<string>} perms 权限集合 */
  /** 特权 CLI（qq-cli）：由主进程执行（凭据/白名单不出沙箱），强制 --as 当前用户（防伪造），参数白名单防注入 */
  async _runPrivilegedCli(argsStr, userId) {
    // ── 参数校验：**白名单**，不是黑名单 ─────────────────────────────────
    //
    // 【为什么要改】原先只做字符黑名单（[;&|`$"'\\\n\r]），它挡不住的是：
    // 一个不含这些字符的参数，将来某次改动把调用方换成 shell:true（或中间多包
    // 一层 shell）时就会变成命令 —— a$(id)b 里的 $、() 都不在黑名单里。
    // 眼下真正兜住的是 execFileSync 的 shell:false + argv 数组，那是「实现的副作用」，
    // 防线长在调用方身上，改一行就没了。改成白名单后即使经过 shell 也无可拼。
    // 每个 action 的参数个数与字符集本来就是固定的，收窄不影响现有用法。
    const RULES = {
      group_history: [/^-?\d{1,20}$/, /^\d{1,3}$/],              // <群号> [条数]
      msg_detail: [/^-?\d{1,20}$/],                              // <消息ID>
      friend_list: [], group_list: [],
      ocr: [/^[\w./:+=%?&@#~-]{1,300}$/],                        // 图片 URL / 文件名
      group_file_url: [/^-?\d{1,20}$/, /^[\w./\\\u4e00-\u9fa5 ()-]{1,200}$/, /^-?\d{1,20}$/],
      download: [/^https?:\/\/[\w.-]+(?::\d+)?\/[\w./%+=&?~#@:!$'()*,\[\]-]{0,1000}$/, /^\d{1,4}$/],
      delete_msg: [/^-?\d{1,20}$/],
      napcat: [/^(?:\.?[\w]){1,64}$/, /^[\x20-\x7e]{0,4000}$/],  // <action> <json>（json 另外解析校验）
      op: [/^-?\d{1,20}$/, /^(?:friend|operator|admin)$/],
      deop: [/^-?\d{1,20}$/],
    };
    const { execFileSync } = await import("node:child_process");
    let args = String(argsStr ?? "").trim().split(/\s+/).filter(Boolean);
    const out = [];
    for (let i = 0; i < args.length; i++) {
      if (args[i] === "--as") { i++; continue; } // 丢弃传入身份，强制为当前沙盒用户
      out.push(args[i]);
    }
    args = out;
    const action = args[0];
    const ALLOW = Object.keys(RULES);
    if (!ALLOW.includes(action)) return { text: `qq-cli 支持的操作: ${ALLOW.join("、")}` };
    const positionals = args.slice(1);
    const rules = RULES[action];
    if (positionals.length > rules.length) {
      return { text: `参数过多（${action} 最多 ${rules.length} 个），已拒绝` };
    }
    for (let i = 0; i < positionals.length; i++) {
      if (!rules[i].test(positionals[i])) {
        return { text: `参数不合法，已拒绝: ${String(positionals[i]).slice(0, 40)}` };
      }
    }
    if (action === "napcat" && positionals[1] !== undefined) {
      try {
        const p = JSON.parse(positionals[1]);
        if (p === null || typeof p !== "object" || Array.isArray(p)) throw new Error("必须是 JSON 对象");
      } catch (e) {
        return { text: `napcat 的第二个参数必须是合法 JSON 对象（${e?.message}）` };
      }
    }
    if (action === "download" && positionals[0] !== undefined && !/^https?:\/\//.test(positionals[0])) {
      return { text: "download 只接受 http(s) 链接" };
    }
    try {
      const outStr = execFileSync("node", [path.join(ROOT, "scripts", "qq-cli.mjs"), "--as", String(userId), ...args], {
        encoding: "utf8", timeout: 90000, shell: false,
      }).trim();
      return { text: outStr || "（无输出）" };
    } catch (e) {
      return { text: `命令退出：${(e?.stdout?.toString?.() || e?.message || "执行失败").toString().slice(0, 1500)}` };
    }
  }

  /** 沙盒受限文件工具（files 权限，bwrap + 路径校验）
   * 仅能读写私有沙盒目录；bash 经 bwrap 强隔离（系统只读、禁网） */
  _sandboxFileTools(perms, userId) {
    const sandbox = this._sessionCwd(userId, perms);
    // 共享目录：所有 operator 沙箱可读写（协作），位于 workspace/shared
    const shared = path.join(WORKSPACE, "shared");
    try { fs.mkdirSync(shared, { recursive: true, mode: 0o777 }); } catch (e) { /* 忽略 */ }
    const allowBase = (base, fp) => {
      const rp = path.resolve(base);
      const fpp = path.resolve(fp);
      return fpp === rp || fpp.startsWith(rp + path.sep);
    };
    const inside = (p) => allowBase(sandbox, p) || allowBase(shared, p);
    const read = defineTool({
      name: "read",
      ...pTool("read", { SANDBOX: sandbox }),
      parameters: Type.Object({ path: Type.String() }),
      execute: async (_id, p) => {
        if (!inside(p.path)) return { content: [{ type: "text", text: `拒绝：路径超出沙盒 ${sandbox}` }], details: {} };
        try { return { content: [{ type: "text", text: fs.readFileSync(p.path, "utf8") }], details: {} }; }
        catch (e) { return { content: [{ type: "text", text: `读取失败: ${e?.message}` }], details: {} }; }
      },
    });
    const write = defineTool({
      name: "write",
      ...pTool("write", { SANDBOX: sandbox }),
      parameters: Type.Object({ path: Type.String(), content: Type.String() }),
      execute: async (_id, p) => {
        if (!inside(p.path)) return { content: [{ type: "text", text: `拒绝：路径超出沙盒 ${sandbox}` }], details: {} };
        try {
          fs.mkdirSync(path.dirname(path.resolve(p.path)), { recursive: true });
          fs.writeFileSync(p.path, p.content);
          return { content: [{ type: "text", text: `已写入 ${p.path}` }], details: {} };
        } catch (e) { return { content: [{ type: "text", text: `写入失败: ${e?.message}` }], details: {} }; }
      },
    });
    const bash = defineTool({
      name: "bash",
      ...pTool("bash", { SANDBOX: sandbox }),
      parameters: Type.Object({
        command: Type.String({ description: "要执行的 shell 命令" }),
        timeout: Type.Number({ description: "超时秒数（必填，上限 120）——必须显式指定" }),
      }),
      execute: async (_id, p) => {
        const { execFileSync } = await import("node:child_process");
        // ── 需要系统凭据的脚本（qq-cli）：由主进程强制以当前用户身份执行（沙箱内不暴露 config/whitelist，身份防伪造） ──
        const m = String(p.command ?? "").match(/^\s*node\s+\S*qq-cli\.mjs\s+(.*)$/s);
        if (m) {
          const res = await this._runPrivilegedCli(m[1], userId);
          return { content: [{ type: "text", text: res.text }], details: {} };
        }
        // 截图等产物默认落在自己的沙盒内（沙箱里 /opt/pi2x/tmp 不可见，不能作默认目录）
        const cmd = `export PI2X_SANDBOX_DIR=${JSON.stringify(sandbox)}; export PI2X_SHARED_DIR=${JSON.stringify(shared)}; cd ${JSON.stringify(sandbox)} && ${p.command}`;
        // ── 沙盒挂载：**白名单**模式 ──────────────────────────────────────────
        //
        // 【为什么从黑名单改成白名单】
        // 原先的做法是「整个文件系统只读挂载，再遮蔽几个敏感路径」，属黑名单 ——
        // 遮了 /root、config.json、whitelist.json、memories，却漏了 sessions/、logs/、
        // state/、browser-profile/（含 admin 登录态）…… 实测 operator 能读到
        // **所有人的聊天记录**。黑名单永远会漏，所以改成白名单：只挂必需的，其余不可见。
        //
        // 白名单内容（每项都有理由，加东西前先想清楚）：
        //   /usr + 标准软链   运行 node/bash 与动态链接器所必需
        //   /etc 下若干单文件  只挂 DNS/证书/用户库；整个 /etc 不可挂
        //                     （里面有 profile.d/cred.sh、deepseek.sh 等密钥）
        //   scripts + node_modules  供 browser-cli 等脚本运行
        //   chrome 二进制     挂到原路径，browser-cli 的 findBin() 无需改动
        //   自己的沙盒 + shared  唯一可写处；shared 是设计上的协作目录
        //
        // 不挂载即不可见：sessions / logs / state / workspace(除 shared) /
        // config.json / whitelist.json / browser-profile / 其他人的沙盒 / /root 其余内容。
        const bwrap = [
          ...(await this._bwrapLauncher()),
          "--unshare-user-try", "--die-with-parent",
          "--ro-bind", "/usr", "/usr",
          "--symlink", "usr/bin", "/bin",
          "--symlink", "usr/lib", "/lib",
          "--symlink", "usr/sbin", "/sbin",
          "--symlink", "usr/lib64", "/lib64",
          "--ro-bind", "/etc/resolv.conf", "/etc/resolv.conf",
          "--ro-bind", "/etc/hosts", "/etc/hosts",
          "--ro-bind", "/etc/nsswitch.conf", "/etc/nsswitch.conf",
          "--ro-bind", "/etc/passwd", "/etc/passwd",
          "--ro-bind", "/etc/group", "/etc/group",
          "--ro-bind", "/etc/ssl", "/etc/ssl",
          "--ro-bind", "/etc/localtime", "/etc/localtime",
          "--ro-bind", path.join(ROOT, "scripts"), path.join(ROOT, "scripts"),
          "--ro-bind", path.join(ROOT, "node_modules"), path.join(ROOT, "node_modules"),
          "--ro-bind", "/root/.cache/ms-playwright", "/root/.cache/ms-playwright",
          "--bind", sandbox, sandbox,
          "--bind", shared, shared,
          "--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp",
          "bash", "-c", cmd,
        ];
        try {
          const out = execFileSync(bwrap[0], bwrap.slice(1), {
            encoding: "utf8",
            timeout: Math.min(Math.max(Number(p.timeout ?? 15), 3), 120) * 1000,
            shell: false,
          }).trim();
          return { content: [{ type: "text", text: out || "（无输出）" }], details: {} };
        } catch (e) {
          const msg = e?.stdout?.toString?.() || e?.message || "执行失败";
          // bwrap 不可用降级提示
          if (/bwrap.*(not found|No such)/i.test(msg)) {
            return { content: [{ type: "text", text: `沙盒不可用（bwrap 缺失）：${msg}` }], details: {} };
          }
          return { content: [{ type: "text", text: `命令退出：${msg.slice(0, 1500)}` }], details: {} };
        }
      },
    });
    // 沙箱版 edit：精确替换（路径校验，仅沙盒内）——防止 SDK 内置全权 edit 泄漏（逃逸）
    const edit = defineTool({
      name: "edit",
      description: `在沙盒目录 ${sandbox} 内的文本文件做精确替换（路径校验，超出拒绝）。参数：path（沙盒内路径）、edits（[{oldText,newText}]）。`,
      parameters: Type.Object({
        path: Type.String({ description: "要编辑的文件（沙盒内路径）" }),
        edits: Type.Array(Type.Object({ oldText: Type.String(), newText: Type.String() }), { description: "精确替换列表" }),
      }),
      execute: async (_id, p) => {
        const fp = path.resolve(String(p.path ?? ""));
        if (!inside(fp)) return { content: [{ type: "text", text: `拒绝：路径超出沙盒 ${sandbox}` }], details: {} };
        try {
          let content = fs.readFileSync(fp, "utf8");
          const list = Array.isArray(p.edits) ? p.edits : [];
          for (const e of list) {
            const oldT = String(e?.oldText ?? "");
            if (!oldT || !content.includes(oldT)) return { content: [{ type: "text", text: `未找到匹配文本: ${oldT.slice(0, 60)}` }], details: {} };
            content = content.split(oldT).join(String(e?.newText ?? ""));
          }
          fs.writeFileSync(fp, content);
          return { content: [{ type: "text", text: `已编辑 ${fp}` }], details: {} };
        } catch (e) { return { content: [{ type: "text", text: `编辑失败: ${e?.message}` }], details: {} }; }
      },
    });
    return [read, write, bash, edit];
  }

  /**
   * 装配当前会话的工具集（委托给 lib/tools/index.mjs 的声明式注册表）。
   *
   * 工具定义按域拆在 lib/tools/*.mjs；权限门禁由 TOOL_PERM 映射统一包装。
   * 这里只负责把 PiAgent 自身作为依赖注入进去。
   * @param {Set<string>} perms 权限 token 集合
   * @param {string} userId 当前用户 QQ 号
   * @returns {Array<any>}
   */
  _buildTools(perms, userId) {
    return buildTools({ me: this, perms, userId });
  }

  /**
   * 命令路由（仅 admin）——消息前缀：
   *   $  执行 Linux Bash（本机，cwd=workspace）
   *   /  内置命令（help/status/memory/perms/whoami）
   *   >  执行 Windows Shell（经 win-agent）
   * @returns {Promise<string|null>} 命令回复；非命令消息返回 null（走正常对话）
   */
  async handleCommand(text, { userId, chatType, targetId }) {
    if (!/^[\$\/>]/.test(text)) return null;
    // /insert：抢占式插入（steer）——交由 handleMessage/_runTurn 处理，不作为内置命令
    if (text.startsWith("/insert")) return null;
    const cmd = String(text).slice(1).trim();
    if (!cmd) return "（命令为空）";
    const perms = this.white.perms(userId);
    if (!perms.has("files:full")) {
      return "该命令前缀仅管理员可用（$ / >）。";
    }
    if (text.startsWith("$")) return this._linuxCmd(cmd);
    if (text.startsWith(">")) return this._winCmd(cmd);
    return this._builtinCmd(cmd, { userId, chatType, targetId });
  }

  async _linuxCmd(cmd) {
    const { spawnSync } = await import("node:child_process");
    try {
      const r = spawnSync("bash", ["-c", "cd " + JSON.stringify(WORKSPACE) + " && " + cmd], {
        encoding: "utf8",
        timeout: 20000,
        maxBuffer: 2 * 1024 * 1024,
      });
      const out = [r.stdout, r.stderr].filter(Boolean).join("\n").trim();
      return "$ " + cmd + "\n" + (out || `（完成，exit=${r.status}）`).slice(0, 2000);
    } catch (e) {
      const err = (e?.stdout?.toString?.() || "") + (e?.stderr?.toString?.() || e?.message || "");
      return "$ " + cmd + "\n（执行失败）" + String(err).trim().slice(0, 1500);
    }
  }

  async _winCmd(cmd) {
    const ws = config.winShell;
    if (!ws?.enabled || !ws?.token) return "（win-agent 未配置）";
    try {
      const resp = await winHost.fetch("/exec", {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${ws.token}` },
        body: JSON.stringify({ command: cmd, shell: "cmd", timeoutMs: 0 }), // > 命令不设超时，自然跑完
      });
      const d = await resp.json().catch(() => ({}));
      if (!resp.ok) return `> ${cmd}\n（win-agent HTTP ${resp.status}: ${d?.error ?? ""}）`;
      const out = (d?.stdout ?? "" ) + (d?.stderr ?? "");
      return "> " + cmd + "\n" + (String(out).trim() || `（完成，exit=${d?.exitCode}）`).slice(0, 2000);
    } catch (e) {
      return `> ${cmd}\n（执行失败: ${e?.message}）`;
    }
  }

  _builtinCmd(cmd, { userId, chatType, targetId }) {
    const [name, ...rest] = cmd.split(/\s+/);
    const entry = PiAgent.BUILTIN[name] ?? PiAgent.BUILTIN[PiAgent.ALIASES[name]];
    if (!entry) return `未知内置命令 /${name}，输入 /help 查看。`;
    // 自动帮助注册：任何内置命令带 -h / --help 参数 → 展示用法（无需每个命令自己实现）
    if (rest.some((a) => a === "-h" || a === "--help")) {
      const usage = entry.usage ? ` ${entry.usage}` : (rest.length ? "" : "");
      return [`用法: /${name}${usage}`.trim(), `说明: ${entry.desc}`].join("\n");
    }
    try {
      // 支持异步 run
      return Promise.resolve(entry.run(this, { userId, chatType, targetId }, rest));
    } catch (e) {
      return `命令 /${name} 执行失败: ${e?.message}`;
    }
  }

  /** 群名（缓存，失败回退群号） */
  _groupNameOf(gid) {
    if (this._groupNameCache.has(gid)) return this._groupNameCache.get(gid);
    const p = (async () => {
      try {
        const r = await this.bridge.api("get_group_info", { group_id: Number(gid) });
        return r?.data?.group_name ?? String(gid);
      } catch {
        return String(gid);
      }
    })();
    this._groupNameCache.set(gid, p);
    return p;
  }

  /**
   * 会话上下文块。
   *
   * 【返回两块，去向不同】（2026-09-12 改）
   *  - `ctxText`  会话上下文（群/用户ID/用户名/时间/权限组）→ **进会话历史**
   *  - `permText` 权限组白名单 → **不进历史**，临时并入当次 system prompt
   *
   * 为什么要把权限白名单拆出去：它原本拼在每条 user 消息头部，写进历史就永久留下。
   * 而它每轮都是同一份内容（同一个人权限不变），几百轮下来纯属白占上下文，
   * 还会在权限调整后留下一堆互相矛盾的历史副本（模型可能引用旧的那份）。
   * 改成每请求临时注入后：历史里只有用户原话，权限始终以“当前这一刻”为准。
   *
   * @returns {Promise<{ctxText:string, permText:string}>}
   */
  async _ctxBlock({ chatType, targetId, userName, userId }) {
    // 当前时间戳（如 2026/9/16 13:21，插入在“权限组”之前）
    const d = new Date();
    const ts = `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
    let base;
    if (chatType === "group") {
      const gname = await this._groupNameOf(targetId);
      base = pSessionContext({
        CHAT_TYPE: `群聊【${targetId} ${gname}】`,
        USER_ID: userId,
        USER_NAME: userName || "未知",
        TIME: ts,
      });
      // 群成员映射（QQ↔昵称，方便理解 @QQ 与群内形况；最多列最近 15 位）
      const members = this._groupMembers.get(String(targetId));
      if (members && members.size) {
        const lines = [];
        for (const [uid, name] of members) {
          if (String(uid) === String(userId)) lines.unshift(`${uid} = ${name}（当前用户）`);
          else lines.push(`${uid} = ${name}`);
        }
        base = base + "\n\n【群成员映射】QQ号 → 昵称（@数字 请对照此表理解指向谁）：\n- " + lines.slice(0, 15).join("\n- ");
      }
    } else {
      base = pSessionContext({
        CHAT_TYPE: "私聊",
        USER_ID: userId,
        USER_NAME: userName || "未知",
        TIME: ts,
      });
    }
    // 权限组白名单由 _permBlock() 单独给出（去向分私聊/群聊，见该方法注释，不进历史）。
    return { ctxText: base, permText: this._permBlock(userId, { chatType }) };
  }

  /**
   * 可用能力块 —— 每请求临时注入 system prompt，**不写进会话历史**。
   *
   * 【为什么从「权限组白名单」改成「可用工具清单」】(2026-10-20)
   * 旧版列的是权限组名 + 权限 token（`memory: memory.search, ...`），有两个致命问题：
   *  1. 模型看不懂 token 与真实工具的对应关系，无法据此判断「我到底能调什么」；
   *  2. `groupsOf()` 对不在名单里的用户返回空数组 → 整块短路成空串，
   *     dialog 用户既看不到任何能力、也不知道自己「什么都没有」。
   * 而静态 system.md 仍写着「主动调 save_memory」「用 ls/read/bash」——
   * 模型于是去调一个不存在的工具，纠结后不输出，用户收到空回复。
   *
   * 现在改成：**按 TOOL_PERM 逐条列出真正可调用的工具名**，并列出不可用的，
   * 无权限时明确写「你没有任何工具」。工具全量挂载 + 运行时审查的设计不变，
   * 这里只是把「审查结果」提前告诉模型，让它别去撞墙。
   *
   * 【约束】只改本块，**不动 system.md 与工具 description** —— 它们进前缀缓存必须稳定；
   * 本块本来就是每请求临时注入的，内容变化不影响缓存命中。
   */
  _permBlock(userId, { chatType = "private" } = {}) {
    // admin 在**私聊**下不显示：他拥有全部权限，逐条列出来纯占上下文。
    // 群聊里仍照常显示（同群里权限各不相同，清单对判断"谁在跟我要东西"仍有价值）。
    if (chatType === "private" && this.white?.presetOf?.(userId) === "admin") return "";

    const preset = this.white?.presetOf?.(userId) ?? "dialog";
    const perms = this.white?.perms?.(userId) ?? new Set();
    // perms 为空 → _createSession 走 noTools="all"，SDK 把**所有**工具（含 TOOL_PERM 为 null 的）
    // 都过滤掉。这个分支必须写清楚，否则模型以为 qq_send_message 还能用。
    const allBlocked = perms.size === 0;

    if (allBlocked) {
      // 无任何权限组的用户仍能用 PUBLIC_TOOLS（含联网搜索）—— 见 _createSession 的 noTools 分支。
      // 这里不能再说「没有任何工具」，否则模型会白白拒掉它真能做的事。
      return [
        `【可用工具】 权限组：${preset}`,
        "你只能用下列工具，清单外的一律不存在：",
        "- 联网搜索：web_search（搜网页）、fetch_content（抓正文，也支持视频字幕）",
        "- 回复与提醒：qq_send_message, set_reminder, list_reminders",
        "其余全部不可用：不能读写文件、不能执行命令、不能查/写长期记忆、不能派发子任务、不能发文件。",
        "- 不知道的事就用 web_search 去查，不要凭空编造；查不到就如实说查不到",
        "- 不要承诺「我去读一下文件」「我跑个命令看看」——你没这个能力，直接说明并建议对方找管理员开权限",
      ].join("\n");
    }

    /** 单个工具是否真的可用。
     *  凭据工具比较特殊：TOOL_PERM 为 null，但 buildTools 里只在 files:full 时注册，
     *  单看 TOOL_PERM 会把它们误判成「人人可用」/「永远不可用」。
     *  group_history / msg_detail / ocr_image / download_file … 这类**没注册成 pi 工具**，
     *  只能经 `node scripts/qq-cli.mjs` 调用 —— 也就是说**必须有 bash** 才用得上。
     *  没有文件权限时它们只是名义上的权限串，列出来会骗模型去调一个不存在的工具。 */
    const canBash = perms.has("files:full");
    const CLI_ONLY = new Set([
      "group_history", "msg_detail", "friend_list", "group_list",
      "ocr_image", "group_file_url", "download_file", "delete_msg", "napcat_call", "op", "deop",
    ]);
    const granted = (name, perm) => {
      if (CLI_ONLY.has(name) && !canBash) return false; // 没有 bash 就跑不了 qq-cli
      return perm === null ? (ADMIN_ONLY_TOOLS.has(name) ? perms.has("files:full") : true) : perms.has(perm);
    };

    const usable = [];
    const denied = [];
    for (const [name, perm] of Object.entries(TOOL_PERM)) {
      (granted(name, perm) ? usable : denied).push(name);
    }
    const hasFull = perms.has("files:full");

    // 按用途分组，一行一类 —— 逐条列 20+ 行会白占上下文，群聊尤为明显。
    const groups = [
      { title: "回复与提醒", keys: ["qq_send_message", "set_reminder", "list_reminders"] },
      { title: "长期记忆", keys: ["search_memories", "save_memory", "delete_memory"] },
      { title: "文件与任务", keys: ["qq_send_file", "run_task", "subagent_send", "subagent_result", "clear_history"] },
      { title: "群信息", keys: ["group_history", "msg_detail", "friend_list", "group_list", "ocr_image", "group_file_url"] },
      { title: "群运维", keys: ["download_file", "delete_msg", "napcat_call", "op", "deop"] },
      { title: "Windows", keys: ["windows_shell_status", "windows_shell", "win_file_get", "win_file_put"] },
      { title: "凭据", keys: ["get_credential", "save_credential"] },
    ];

    const lines = [`【可用工具】 权限组：${preset}`, "只能用下面列出的工具，清单外的一律不存在："];
    for (const g of groups) {
      const hit = g.keys.filter((k) => usable.includes(k));
      if (hit.length) lines.push(`- ${g.title}：${hit.join(", ")}`);
    }
    if (hasFull) lines.push(`- 文件与命令：${BUILTIN_FILE_TOOLS.join(", ")}`);

    // 命令前缀与内置命令：与 handleCommand 的第一道门严格一致（files:full）
    if (hasFull) {
      lines.push(`命令：$ …（Linux）、> …（Windows）、${Object.keys(PiAgent.BUILTIN).map((n) => `/${n}`).join(" ")}`);
    } else {
      lines.push("命令：$ / > 与内置命令均不可用（仅管理员）");
    }

    if (denied.length) {
      lines.push(`不可用：${denied.join(", ")}`);
      lines.push("对不可用能力：不要调用、不要假装调用、不要承诺「我去做」——直接说明权限不足。");
    }
    return lines.join("\n");
  }

  /**
   * 命中一个启用的 persona（config.pi.persona，全局生效——不限定 userId）。
   *
   * 统一人设：所有人读同一个 promptFile，不再按权限组选不同文件。
   * （历史：曾按 admin/public 二选一，见 git log 中「统一人设」那次改动。）
   *
   * @returns {{enabled?:boolean, promptFile:string, isAdmin:boolean}|null} 未启用 / 未配置返回 null
   */
  _personaFor(userId) {
    const persona = config.pi?.persona;
    if (!persona) return null;
    const key = Object.keys(persona).find((k) => persona[k]?.enabled);
    if (!key) return null;
    const p = persona[key];
    if (!p?.promptFile) return null;
    return { ...p, promptFile: String(p.promptFile), isAdmin: this.white?.presetOf?.(userId) === "admin" };
  }

  /** 把群消息里的 @纯数字 替换成 @昵称(QQ)（映射命中时；未知名保留原样） */
  _resolveAtNames(text, gid) {
    const m = this._groupMembers.get(String(gid));
    if (!m || !m.size) return text;
    return String(text).replace(/@(\d{5,})/g, (full, qq) => {
      const name = m.get(String(qq));
      return name ? `@${name}(${qq})` : full;
    });
  }

  /** 处理一条 QQ 消息（允许并发：同一会话消息并行提交，SDK followUp 排队）
   * @param {{chatKey:string, text:string, chatType:string, targetId:string, selfId:string, userName:string, userId:string, images?:Array}} opts */
  handleMessage({ chatKey, text, chatType, targetId, selfId, userName, userId, images, skipMemory }) {
    // 群成员 QQ↔昵称 映射维护（增量：首次见过的用户记入，昵称变更覆盖）
    if (chatType === "group" && userId && userName) {
      let m = this._groupMembers.get(String(targetId));
      if (!m) { m = new Map(); this._groupMembers.set(String(targetId), m); }
      m.set(String(userId), String(userName));
      if (m.size > 100) { // 防无限膨胀：超限时移除最旧的（Map 按插入序）
        const oldest = m.keys().next().value;
        if (oldest !== undefined) m.delete(oldest);
      }
    }
    // RED 高风险接口的拦截在 qq-cli 的 napcat 分支（riskOf 判定），入口处不再有二次确认
    const perms = this.white.perms(userId);
    // 非 admin 请求风险评估（工作流硬门禁）：deny 直接拦截，其余放行但注入风险结论
    return this._gateRisk({ chatKey, text, chatType, targetId, selfId, userName, userId, images, perms, skipMemory });
  }

  /** 非 admin 请求风险评估门禁（工作流层，非模型工具）
   * 流程：先本地规则快筛 → 拿不准唤醒只读评审 subagent。
   * deny → 直接拒绝；confirm → 放行但注入"需谨慎/二次确认"结论；allow → 正常放行。 */
  async _gateRisk({ chatKey, text, chatType, targetId, selfId, userName, userId, images, perms, skipMemory }) {
    // admin（files:full）不评审，直接走主 agent
    if (perms.has("files:full")) {
      return this._runTurn({ chatKey, text, chatType, targetId, selfId, userName, userId, images, perms, riskNote: "", skipMemory });
    }
    let verdict = null;
    try {
      verdict = await assessRequest({
        userId,
        chatType,
        targetId,
        userName,
        preset: this.white.presetOf(userId),
        userText: text,
        // 复用会话模型依赖（评审独立 loader 使用）
        modelRuntime: this.modelRuntime,
        model: this.model,
        loader: this.loader,
        agentDir: AGENT_DIR,
      });
    } catch (e) {
      logRisk.error(`风险评审失败（保守处理）: ${e?.message}`);
    }
    // 【评审不可用时必须保守，不能放行】
    // 原先这里写 `verdict?.action ?? "allow"`：评审一旦失败（返回 null / 抛错），
    // 就静默按 allow 放行 —— 与 assessRequest 内部自己的兜底（confirm）自相矛盾，
    // 且日志只记 error 不记 warn，出事后很难发现"免检"状态。
    // 现在统一为 confirm：宁可多问一句，也不静默执行。
    const act = verdict?.action ?? "confirm";
    if (!verdict) {
      logRisk.warn(`风险评审不可用（非 admin ${userId}），本轮按「需确认」处理，未静默放行`);
      // 评审不可用时给出保守提示，让主 agent 主动向用户确认后再动手
      const fallbackNote = pRiskNote({
        LEVEL: "未知",
        SOURCE: "review-unavailable",
        REASON: "风险评审未能给出结论（评审服务异常）",
        CONFIRM_HINT: "若涉及写/改/执行/外部传输，请先向用户确认目标与影响，再谨慎执行。",
      });
      return this._runTurn({ chatKey, text, chatType, targetId, selfId, userName, userId, images, perms, riskNote: fallbackNote, skipMemory });
    }
    if (act === "deny") {
      logRisk.warn(`拦截非 admin ${userId} 请求: ${verdict?.reason ?? "高危"}`);
      return `⚠️ 该操作已被安全策略拦截：${verdict?.reason ?? "存在安全风险"}。需要管理员授权后才能执行。`;
    }
    // allow / confirm：注入风险结论，主 agent 据此执行
    const riskNote = verdict
      ? pRiskNote({
          LEVEL: verdict.level,
          SOURCE: verdict.source,
          REASON: verdict.reason,
          CONFIRM_HINT: act === "confirm" ? "若涉及写/改/执行/外部传输，请先向用户确认目标与影响，再谨慎执行。" : "",
        })
      : "";
    return this._runTurn({ chatKey, text, chatType, targetId, selfId, userName, userId, images, perms, riskNote, skipMemory });
  }

  /** 实际执行一轮（把风险研判注入上下文后交给主 agent）——按会话串行，避免并发 submit 事件错位 */
  async _runTurn({ chatKey, text, chatType, targetId, selfId, userName, userId, images, perms, riskNote, skipMemory }) {
    const entry = await this._getSession(chatKey, userId);

    // 记下这个人当前在哪个会话说话 —— 供 qq-cli 子进程做「只能查当前群」的判定。
    // 写文件失败不影响本轮（旁路信息，不是关键路径）。
    try { rememberChat(userId, chatType, targetId); } catch { /* 忽略 */ }
    // /insert 前缀 → 抢占式 steer（用户主动打断/指导正在运行的 agent）。其余普通消息在流式时改为 nextTurn（排队到下一轮，不打断）。
    const insertM = text.match(/^\/insert\s+(.+)/s);
    const insertText = insertM ? insertM[1] : null;
    // /insert 仅管理员可用（占位抢断指令）；非 admin 使用则拒发
    if (insertText != null && !perms?.has("files:full")) {
      logSteer.warn(`${chatKey} 非 admin 尝试 /insert，已拒绝`);
      return "（/insert 仅管理员可用）";
    }
    if (entry.session?.isStreaming) {
      try {
        // 抢注同样建立本轮的 ALS 上下文（工具在被注入的这轮里执行时要能读到正确的"我是谁"）
        const steerCtx = { chatType, targetId, selfId, userName, userId, chatKey, currentSessionKey: entry.key ?? chatKey };
        const injectText = insertText != null ? insertText : text;
        await runWithTurnCtx(steerCtx, () => entry.session.steer(injectText, images));
        logSteer.info(`${chatKey} <${userName}>: ${insertText != null ? "/insert" : "抢注"} 已注入（流式中）: ${injectText.slice(0, 60)}`);
        return ""; // 不单独结算，由 agent 后续/下一轮输出体现
      } catch (e) {
        logSteer.error(`${chatKey} 流式注入失败，回退串行: ${e?.message}`);
      }
    }
    // 同一会话串行处理：接在上一轮尾巴上，确保一次只有一条 submit 在跑
    //
    // 【为什么整轮包在 runWithTurnCtx 里】
    // 上下文原本写在 this.ctx（实例单例）上，并发会话会互相覆盖 ——
    // 后果包括「消息发进别人的会话」「私聊记忆写进群共享」等（详见 lib/turn-context.mjs）。
    // 改用 AsyncLocalStorage 后，上下文随异步链走，与本轮一一对应，与并发无关。
    const turnCtx = { chatType, targetId, selfId, userName, userId, chatKey, currentSessionKey: entry.key ?? chatKey };
    const run = entry.tail.then(() => withTurn(chatKey, () => runWithTurnCtx(turnCtx, async () => {
      const tTurn = Date.now();
      // 标记轮次进行中：闲置压缩必须跳过 —— 工具调用跑十几分钟是**忙碌**不是闲置，
      // 那种情况下压缩既会与在途请求抢资源，也可能打断工具链。
      entry.turnRunning = true;
      const logTurn = createLogger("turn");
      logTurn.info(`开始 · ${chatType} · ${userName ?? "?"}`);
      // 会话上下文注入：ctxText 进历史；permText（权限白名单）临时注入 system，不进历史
      let ctxText = "";
      let permText = "";
      try {
        const blk = await this._ctxBlock({ chatType, targetId, userName, userId });
        ctxText = blk.ctxText;
        permText = blk.permText;
      } catch (e) {
        logPi.error(`上下文注入失败: ${e?.message}`);
      }
      // 权限白名单 + 风险研判：每请求临时注入，**都不进历史**。
      // 它们原本直接拼在 user 消息头部写进历史 —— 权限白名单每轮重复同一份内容，
      // 风险研判更是「只对当前这一次请求有效」的东西，留在历史里既占空间又会误导后续判断。
      //
      // 【权限白名单的去向按会话类型分派】(2026-09-12)
      //   私聊 → 并入 system prompt。
      //     理由：同一私聊对象的权限在整个会话期间是**稳定**的，system 内容不随轮次变化，
      //     因此不会破坏前缀缓存；放在最前也最符合「这是你当前的身份与权限」的语义。
      //   群聊 → 仍走报文末尾临时注入。
      //     理由：群里每次说话的人可能不同，权限随成员变化；挂末尾可让前缀保持稳定。
      patchTurnCtx({
        permBlockSys: chatType === "group" ? "" : permText,
        permBlockTail: chatType === "group" ? permText : "",
        riskNote: riskNote ?? "",
      });
      // 记忆注入（无感：检索相关记忆拼在用户消息前）
      // 若用户用 /insert 前缀（空闲时）也剥离开，提交真实内容
      let finalText = insertText != null ? insertText : text;
      // 群消息：把 @纯数字 解析成 @昵称(QQ)（便于模型理解 @指向谁）
      if (chatType === "group") finalText = this._resolveAtNames(finalText, targetId);
      if (this.memory && !skipMemory) {
        const stopMem = logTurn.time("记忆注入");
        try {
          // 记忆注入：预计算后存到 this.ctx.memInjection，由扩展 before_agent_start 并入当次 system prompt（不进历史）
          const inj = await this.memory.injectText({ query: text, chatType, userId, targetId, includeGlobals: !entry.globalInjected });
          if (inj.text) patchTurnCtx({ memInjection: inj.text });
          entry.lastInjectedIds = inj.ids ?? [];
          entry.globalInjected = true;
          stopMem(`命中 ${entry.lastInjectedIds?.length ?? 0} 条`);
        } catch (e) {
          stopMem(`失败`);
          logMemory.error(`记忆注入失败: ${e?.message}`);
        }
      }
      // 注意：风险研判 / 权限白名单已改为临时注入 system prompt（见上方 patchTurnCtx），
      // 这里只拼会话上下文 + 用户原话，尽量让历史保持干净。
      finalText = (ctxText ? ctxText + "\n\n" : "") + finalText;

      let reply = "";
      try {
        // 若 compaction 进行中，先等待其完成，避免 pi 拒绝并发提交
        await this._waitCompaction(entry);
        // —— 工具调用文本泄露检测 + 重试 ——
        // 模型偶发把工具调用写成 <tool_calls>/<invoke> 纯文本（而非走正常 toolCall 事件流），
        // 会被 text_delta 收进回复文本，直接漏给用户。这里检测到就不发，注入纠正指令让模型重新生成。
        // 泄露标记可能被模型输出污染成 <ÿÿDSMLÿÿtool_calls> / <｜Μ｜invoke name=…>（全角竖线｜/乱码混入标签名），
        // 正则采用宽松匹配（见 detectToolLeak）：< 到 name= 之间允许任意非 > 字符。
        const hasToolLeak = detectToolLeak;
        const LEAK_MAX = Number(config.pi.leakMaxRetries); // 连续泄露上限（config.pi.leakMaxRetries）
        let leakCount = 0;
        let emptyRetry = 0;                 // 「空回复」换连接重试次数
        const EMPTY_MAX = Number(config.pi.emptyRetryMax);
        let curText = finalText;
        let curImages = images;
        // 增量流式发送：每个 text_delta 到自然边界即发（不再攒到回合结束）。
        // config.pi.streamReplies === false 可关闭（回到“整段一次性发送”行为）。
        const streamSend = config.pi?.streamReplies === false
          ? null
          : async (part) => {
              const t = String(part ?? "").trim();
              if (!t) return;
              if (chatType === "group") await this.bridge.sendGroupMsg(Number(targetId), t);
              else await this.bridge.sendPrivateMsg(Number(targetId), t);
            };
        for (;;) {
          const stopModel = logTurn.time(leakCount > 0 ? `模型调用(第 ${leakCount + 1} 次·泄露重试)` : "模型调用");
              reply = (await entry.asm.submit(curText, curImages, { send: streamSend })) || "";
          stopModel();
          if (!hasToolLeak(reply)) {
            // 【空回复重试】只在本轮**什么都没送出去**时重试。
            //
            // 【为何不能用“最终正文为空”当判据（2026-09-24 踩过的坑）】
            // 内容正常流式送达时，turn-assembler 会把 out 置为空串（已增量送达就不再整段重发），
            // 于是 reply === "" 是**正常情况**。曾把判据改成“final 无正文（含 delivered）”
            // 以覆盖“只吐了过程话、没给结论”的场面，结果每个正常轮次都被当成异常：
            // 用户收到完整回答后，模型又被追问一遍、又生成一份（实测 1844 字 + 1836 字，重复回答）。
            // 所以此处维持旧条件：只有 empty（无 bufText/无 toolSent/无流式）才重试。
            // “过程话后模型不再给结论”属于模型行为，不在这里造二次调用。
            const lt = entry.asm.lastTurn ?? {};

            // 【历史中毒自愈】模型报的错是「tool 消息找不到对应的 tool_calls」——
            // 这不是重试能修的：历史里就多了一条对不上的工具结果，每次请求都会 400，
            // 重试多少次都是同一个 400。原先没识别这一种，于是同一个 400 白白重试了 3 天
            // （2026-10-22 ~ 10-25，用户看到的只有「（这次模型返回了空内容）」）。
            //
            // 这里就地修文件 + 丢掉内存里的会话对象：下一轮 _createSession 会读回修好的历史，
            // 对话记录一条不丢，只是那条非法条目被剔掉了。
            if (isOrphanToolResultError(lt.err) && !entry.__healed) {
              entry.__healed = true; // 同一轮最多修一次，防死循环
              try {
                const sk = entry.key ?? sessionKeyOf(chatKey, userId);
                const f = path.join(SESSIONS_DIR, `${this._safeKey(sk)}.jsonl`);
                const r = repairSessionFile(f, { fs });
                logPi.warn(
                  `${chatKey} 检测到历史含孤儿工具结果（400），已修复：` +
                    `剔除 ${r.removed?.length ?? 0} 条${r.backup ? ` · 备份 ${path.basename(r.backup)}` : ""}`,
                );
                // 内存里的会话仍持有坏历史，必须扔掉重建
                try { entry.session.dispose(); } catch {}
                this.sessions.delete(sk);
                this.sessions.delete(chatKey);
                try {
                  if (chatType === "group") await this.bridge.sendGroupMsg(Number(targetId), "（检测到对话历史里有一条损坏的工具记录，已自动修复，重新问我一次就好喵）");
                  else await this.bridge.sendPrivateMsg(Number(targetId), "（检测到对话历史里有一条损坏的工具记录，已自动修复，重新问我一次就好喵）");
                } catch { /* 通知失败不影响修复 */ }
              } catch (e) {
                logPi.warn(`${chatKey} 历史自愈失败: ${e?.message}`);
              }
            }

            if (!reply && lt.empty && !lt.delivered && !lt.timedOut && emptyRetry < EMPTY_MAX) {
              emptyRetry++;
              logPi.warn(`${chatKey} 模型返回空内容，换连接重试（第 ${emptyRetry}/${EMPTY_MAX} 次）`);
              curText = pRetryEmptyReply();
              curImages = [];
              continue;
            }
            break; // 无泄露，成功脱离
          }
          leakCount++;
          logLeak.warn(`${chatKey} 第 ${leakCount}/${LEAK_MAX} 次检测到工具调用文本泄露，注入纠正指令重试`);
          if (leakCount >= LEAK_MAX) {
            // 连续多次仍泄露：停止正常输出，改让模型生成一句失败提示
            curText = pRetryLeakFinal();
            curImages = [];
          } else {
            // 未达上限：提示模型走真正的工具通道，或删掉泄露标记只输出用户结果
            curText = pRetryLeakRetry();
            curImages = [];
          }
        }
        // 奔底：最后一次若仍泄露（模型连失败提示都泄了），用固定兜底文案，避免死循环
        if (hasToolLeak(reply)) reply = "（工具调用失败，请稍后重试）";
      } catch (e) {
        logPi.error(`${chatKey} submit 异常: ${e?.message}`);
      }
      // 清掉本请求的记忆注入（它已随本次 systemPrompt 生效）。
      // ALS 上下文本就随本轮结束而丢弃，这里删一下只是为了 dump 更干净。
      deleteTurnCtxField("memInjection");

      // 自动 compact：会话上下文接近上限时，用 pi 内置压缩精简历史（不阻塞当次回复）
      //
      // 【收割时机已从「每轮结束」改为「压缩时」】
      // 原先每轮结束都异步跑一次 harvest，靠 10 分钟节流控成本。问题有两面：
      //   · 每轮都跑 → 每轮多一次 LLM 调用，成本翻倍，且大多数轮次没什么值得记的；
      //   · 节流又会漏 —— 关键信息落在被节流掉的那一轮，就再也没机会被记下。
      // 而「压缩」恰好是**历史即将被丢弃**的那一刻：此前的每轮收割本质是在反复
      // 扫描很多还没丢的内容（重复劳动），真正需要抢救的只有压缩前这一段。
      // 现在只在压缩前抽一次（见 _compactNow），既省调用又不漏。
      const harvestText = entry.asm.lastFullText || reply;
      entry.lastTurnText = { userText: text, botText: harvestText };
      this._maybeCompact(entry, chatKey);
      logTurn.info(`完成 · ${Date.now() - tTurn}ms · 回复 ${reply.length} 字`);
      return reply;
    })));
    // 无论成败，收尾更新 tail（清除失败状态，避免卡死后续）
    entry.tail = run
      .catch((e) => { logPi.error(`${chatKey} turn 失败: ${e?.message}`); return ""; })
      .finally(() => {
        // 整轮（所有工具/子任务）结束：清除忙碌标记，并重置闲置计时起点
        entry.turnRunning = false;
        entry.lastTurnEndAt = Date.now();
      });
    return run;
  }

  /**
   * 取「当前会话」的上下文占用，供 /status 展示。
   *
   * 【为什么要从活跃会话反查】
   * /status 是内置命令，不走 _runTurn，所以 this.ctx 里的 chatKey 还是上一次对话留下的，
   * 直接用可能对不上（尤其刚重启、ctx 尚未被赋值时）。
   * 更稳的做法：在活跃会话表里找一个当前正在流式输出的（就是发命令的这个），
   * 找不到就退化为「取任一活跃会话」，一个都没有则返回空（/status 不显示该行）。
   *
   * 量纲注意事项见 lib/agent/compact-policy.mjs 的 fmtContextUsage。
   *
   * @returns {string[]} 0 或 1 行文本
   */
  /** 由内置命令上下文推出会话键（规则见 lib/agent/chat-key.mjs，与收消息路径共用同一实现） */
  _chatKeyOf(ctx) {
    return chatKeyOf(ctx);
  }

  /**
   * 取「当前会话」的上下文占用，供 /status 展示。
   *
   * 【为什么不能只看 this.sessions】
   * /status 是内置命令，不走 _runTurn，因此它执行时**不一定**存在活跃会话。
   * 最典型的是刚重启完：会话表是空的，用户第一条命令就是 /status ——
   * 此时如果只查 sessions，就什么都显示不出来（线上就踩到了这个）。
   *
   * 所以策略是三级：
   *   1) 会话表里已有该会话 → 直接用
   *   2) 没有 → 按需获取/建立（_getSession 幂等，后续对话会复用它，不算浪费）
   *   3) 仍拿不到 → 返回空数组，/status 少一行而不是报假数
   *
   * 量纲注意事项见 lib/agent/compact-policy.mjs 的 fmtContextUsage。
   *
   * @param {{userId?:string, chatType?:string, targetId?:string}} [ctx]
   * @returns {Promise<string[]>} 0 或 1 行文本
   */
  async _statusContextUsage(ctx) {
    try {
      const key = this._chatKeyOf(ctx);
      let entry = pickSessionEntry(this.sessions, key);
      // 会话表里没有该会话（例如刚重启后第一条命令就是 /status）→ 按需取一个。
      // 这是线上真实踩到的场景：重启后 /status 什么都显示不出来。
      if (!entry && key && ctx?.userId) {
        try {
          entry = await this._getSession(key, String(ctx.userId));
        } catch (e) {
          logPi.warn(`/status 取上下文时会话获取失败: ${e?.message}`);
        }
      }
      if (!entry) return [];
      const cu = entry.session?.getContextUsage?.();
      if (!cu) return [];
      return [CP.fmtContextUsage(cu)];
    } catch (e) {
      return [`上下文 取数异常：${String(e?.message ?? e).slice(0, 40)}`];
    }
  }

  /** 等待 compaction 完成（若正在压缩）。靠 session.isCompacting + entry.compacting 标志 + 超时兑底。 */
  async _waitCompaction(entry) {
    const session = entry?.session;
    if (!session) return;
    // pi 提供 isCompacting；entry.compacting 是我们自己触发的标志
    const isBusy = () => session.isCompacting === true || entry.compacting === true;
    if (!isBusy()) return;
    await new Promise((resolve) => {
      let done = false;
      const finish = () => { if (!done) { done = true; session.unsubscribe?.(off); clearTimeout(timer); resolve(); } };
      const off = session.subscribe((ev) => {
        if (ev.type === "compaction_end" || ev.type === "compaction_start") {
          // compaction_start 表示新一轮开始（可能又忙），compaction_end 表示结束
          if (ev.type === "compaction_end") finish();
        }
      });
      // 兜底轮询：若事件未触发，靠轮询 isCompacting
      const timer = setInterval(() => { if (!isBusy()) finish(); }, 500);
      // 超时兑底（防止卡死）：120s 后强制继续
      setTimeout(finish, 120000);
    });
  }

  /** 自动 compact：会话上下文占用超过阈值时，用 pi 内置压缩精简历史（不阻塞当次回复）
   *
   * 量纲契约：pi 的 getContextUsage().percent 是 **0~100 的百分数**，
   * config.pi.compactPercent 必须同量纲（默认 70 = 占用 70%）。
   * 判定逻辑在 lib/agent/compact-policy.mjs（纯函数 + 单测覆盖）。
   * @param {any} entry 会话 entry
   * @param {string} chatKey */
  _maybeCompact(entry, chatKey) {
    const threshold = CP.resolveThreshold(config.pi?.compactPercent, 70);
    const cooldownMs = Number(config.pi.compactCooldownMs);
    try {
      const cu = entry.session?.getContextUsage?.();
      // 单一触发条件：占模型窗口的比例超过阈值。
      // 注意量纲 —— cu.percent 已经是 0~100，阈值同量纲（config.pi.compactPercent）。
      if (cu?.percent == null) return;
      if (!CP.shouldCompact(cu.percent, threshold)) return;

      // 防重入 & 冷却
      if (!CP.canTrigger({ compacting: entry.compacting, lastCompactAt: entry.lastCompact ?? 0, cooldownMs })) return;
      // fromTurnEnd=true：本检查就在轮内（早于 turnRunning 清除），
      // 此时回复已产出，压缩不会影响本轮结果，故不套用「轮次进行中即取消」的检查。
      this._compactNow(entry, chatKey, `${CP.fmtPercent(cu.percent)} 达阈值 ${threshold}%`, true);
    } catch (e) {
      logCompact.warn(`${chatKey} 检查失败: ${e?.message}`);
    }
  }

  /**
   * 启动「闲置压缩」巡检（每 60 秒扫一遍所有活跃会话）。
   *
   * 【为什么必须有独立定时器】原有的压缩检查只在**一轮对话结束时**跑。
   * 于是这个情形永远压不到：上下文停在 30%（低于阈值 40%），会话随后一小时没人说话 ——
   * 期间没有任何轮次结束，检查逻辑根本没机会执行；等下次有人开口时，
   * 第一轮又要带着这 30% 的陈旧上下文去请求。
   * 闲置期恰恰是最佳压缩时机：没人在等回复，几十秒的压缩耗时完全不占用户等待。
   *
   * 【两条必须同时满足】（见 compact-policy.shouldCompactOnIdle）
   *   · **整轮（含该轮所有工具调用/子任务）结束**后超过 23 小时 —— 真的没人在用；
   *   · 上下文大于 20% —— 太小则压了不划算（刚压完又压纯属浪费）。
   *
   * 【关键：工具跑很久属于忙碌，不是闲置】一轮里工具执行十几分钟（下载大文件、
   * 长命令、子代理任务）时**整轮还没结束**，此时绝不能压。所以有两道保护：
   *   · 计时起点是「整轮结束时刻」，工具还在跑时这个时间根本不会更新；
   *   · 额外要求 `!entry.turnRunning`，并在真正压缩前再确认一次 ——
   *     否则会与在途请求抢资源、甚至打断工具链。
   */
  _startIdleCompact() {
    const idleMs = Number(config.pi?.compactIdleMs ?? 23 * 60 * 60 * 1000);
    const floor = Number(config.pi?.compactIdlePercent ?? 20);
    const tickMs = Number(config.pi?.compactIdleScanMs ?? 60 * 1000);
    if (!(idleMs > 0) || !(floor > 0)) {
      logCompact.info("闲置压缩未启用（compactIdleMs / compactIdlePercent 配置无效）");
      return;
    }
    const timer = setInterval(() => {
      try {
        const now = Date.now();
        for (const [chatKey, entry] of this.sessions) {
          // 忙碌中（含工具执行）→ 跳过。这是本条策略最重要的安全阀。
          if (entry.turnRunning) continue;
          if (entry.compacting) continue;
          const cu = entry.session?.getContextUsage?.();
          if (cu?.percent == null) continue;
          // 闲置 = 整轮结束后经过的时间（不是"距上次 LLM 调用" —— 那个会被轮内工具刷新）
          const idle = now - (entry.lastTurnEndAt ?? 0);
          if (!CP.shouldCompactOnIdle({ percent: cu.percent, idleMs: idle, idleThresholdMs: idleMs, percentFloor: floor })) continue;
          // 冷却：与常规压缩共用同一套防抖，避免刚压完又压
          if (!CP.canTrigger({ compacting: entry.compacting, lastCompactAt: entry.lastCompact ?? 0, cooldownMs: Number(config.pi.compactCooldownMs) })) continue;
          this._compactNow(entry, chatKey, `闲置 ${Math.round(idle / 60000)} 分钟 · 上下文 ${CP.fmtPercent(cu.percent)}`);
        }
      } catch (e) {
        logCompact.warn(`闲置巡检异常: ${e?.message}`);
      }
    }, tickMs);
    timer.unref?.(); // 不阻止进程退出
    this._idleCompactTimer = timer;
    logCompact.info(`闲置压缩已启用：闲置 ≥ ${Math.round(idleMs / 60000)} 分钟且上下文 > ${floor}% 时触发（每 ${Math.round(tickMs / 1000)} 秒巡检）`);
  }

  /**
   * 执行一次压缩（常规触发与闲置触发共用；确保同时只有一次在跑）。
   *
   * @param {object} entry 会话条目
   * @param {string} chatKey 会话键（日志用）
   * @param {string} why 触发原因（日志用）
   * @param {boolean} [fromTurnEnd] 是否来自「轮次结束时的阈值检查」。
   *
   * 【为什么需要这个参数】两类触发的时机不同，安全检查也不同：
   *   · 闲置巡检（fromTurnEnd=false）：此时本不该有任何轮次在跑。
   *     若判定后发现轮次起来了，就**必须取消** —— 否则会打断工具链。
   *   · 轮次结束时的阈值检查（fromTurnEnd=true）：它**就在轮内**调用
   *     （在 _maybeCompact 里，早于 turnRunning 清除），所以此时 turnRunning
   *     必然为 true。若不加区分地拦，40% 阈值这条主路径会被永久取消 ——
   *     这正是修复前的实际故障：上下文 41.5% 却一直不压。
   *     但此时**回复已经产出**（submit 已返回），压缩不会再影响这一轮的结果，
   *     因此放行是安全的。
   */
  _compactNow(entry, chatKey, why, fromTurnEnd = false) {
    if (entry.compacting) return;
    // 二次确认：仅在闲置巡检路径下生效（见上面的时机说明）
    if (!fromTurnEnd && entry.turnRunning) {
      logCompact.info(`${chatKey} 压缩取消（判定后出现进行中的轮次，避免打断工具链）`);
      return;
    }
    entry.compacting = true;
    const started = Date.now();
    logCompact.info(`${chatKey} 触发压缩（${why}）`);
    // 供 session_before_compact 钩子取用：pi 的钩子事件里不含我们的 entry，
    // 而记忆写入需要 entry 上的 userId/chatType/targetId（闲置压缩时没有轮次上下文）。
    this._compactEntryHint = entry;

    // 【收割唯一时机：压缩之前】
    // 压缩会把这段历史换成一份摘要，之后就再也看不到原文了。
    // 所以在这里（且只在这里）把完整上下文交给记忆库，抽成长期事实。
    //
    // 【合并模式下不再单独收割】开启 mergeHarvestIntoCompact 时，摘要与事实由
    // session_before_compact 钩子里的**同一次调用**产出（见 _buildMergedCompaction）。
    // 此时若还在这里另跑一遍 harvest，同一批内容会被抽两次 —— 既浪费一次调用，
    // 又容易产生语义重复的条目（两次输出措辞不同，向量合并兜不住）。
    if (!mergeEnabled()) {
      // 异步不等待 —— 收割要调一次 LLM（数秒），不能拖慢压缩；即便它慢于压缩也没关系，
      // 因为我们传进去的是**取好的消息快照**（messages 是数组，已与后续改动解耦）。
      this._harvestBeforeCompact(entry, chatKey);
    }

    entry.session
      .compact()
      .then(() => {
        entry.lastCompact = Date.now();
        const after = entry.session?.getContextUsage?.();
        logCompact.info(
          `${chatKey} 已压缩 · ${why} → ${after?.tokens != null ? `${after.tokens} token` : "完成"}` +
            ` · ${Date.now() - started}ms`
        );
      })
      .catch((e) => logCompact.warn(`${chatKey} 压缩失败: ${e?.message}`))
      .finally(() => {
        entry.compacting = false;
        if (this._compactEntryHint === entry) this._compactEntryHint = null;
      });
  }

  /**
   * 合并压缩（A1）：调一次模型，同时拿到「摘要」与「长期事实」。
   *
   * @param {{prep:any, ctx:any, event:any}} o
   * @returns {Promise<{compaction:any}|null>} null = 不接管，交给 pi 的标准摘要
   */
  async _buildMergedCompaction({ prep, ctx, event, entry: entryIn }) {
    const msgs = prep?.messagesToSummarize;
    const firstKeptEntryId = prep?.firstKeptEntryId;
    if (!Array.isArray(msgs) || !msgs.length || !firstKeptEntryId) return null;

    const model = ctx?.model ?? this.model;
    if (!model) return null;

    // 凭证：与 pi 内部取摘要凭证走同一套解析（_getSummarizationRequestAuth）。
    // 实测 AuthResult 形如 { auth: { apiKey, headers, baseUrl? }, source, env? }。
    //
    // ⚠ baseUrl 必须一并采用：provider 可能用 auth 覆盖模型自带地址
    // （pi 内部就是 `auth.baseUrl ? {...model, baseUrl} : model`）。
    // 漏掉它就会把请求发到模型对象里的旧地址上 —— 平时看不出，换个 provider 才炸。
    let requestModel = model;
    let apiKey, headers, env;
    try {
      const auth = await ctx?.modelRegistry?.getAuth?.(model);
      apiKey = auth?.auth?.apiKey;
      headers = auth?.auth?.headers;
      env = auth?.env;
      if (auth?.auth?.baseUrl) requestModel = { ...model, baseUrl: auth.auth.baseUrl };
    } catch {
      /* 取不到就让 SDK 自己想办法 */
    }

    // 摘要预算：与 makeSettingsManager 用同一份配置（config.pi.compactionReserveTokens，
    // 默认 40983 ⇒ 摘要上限 floor(0.8×40983)=32786）。这里不读 settingsManager ——
    // 它是**每会话**创建的实例，PiAgent 上没有这个字段（曾经写过，等于永远走 fallback）。
    const reserveTokens = Number(config.pi?.compactionReserveTokens ?? 40983);

    // 自定义指令：拼接我们的「事实抽取」要求，pi 会把它附加到标准摘要提示词之后
    const extra = loadPrompt("memory", "compact-merged.md");
    if (!extra) return null;

    let text, stopReason;
    try {
      const r = await generateSummary(
        msgs,
        requestModel,
        reserveTokens,
        apiKey,
        headers,
        event?.signal,
        extra, // customInstructions（pi 会以 "Additional focus: ..." 附加）
        prep?.previousSummary,
        ctx?.thinkingLevel,
        undefined, // streamFn：用 SDK 自己的
        env,
      );
      text = r;
    } catch (e) {
      logPi.warn(`合并压缩调用失败，回退标准摘要: ${e?.message}`);
      return null;
    }

    const { summary, facts, usedIds, parseError } = splitCompactOutput(text);
    if (parseError) logMemory.warn(`合并压缩：${parseError}（摘要仍交付）`);

    // 摘要不可用（空 / 截断）→ 不接管。截断的摘要 pi 会拒收并放弃整次压缩，
    // 这里主动回退，让 pi 用标准摘要重来。
    const bad = summaryRejection({ summary, stopReason });
    if (bad) {
      logPi.warn(`合并压缩摘要不可用（${bad}），回退标准摘要`);
      return null;
    }

    // 文件清单：接管后 pi 不会再加，得我们自己补上
    let finalSummary = summary;
    try {
      const { readFiles, modifiedFiles } = computeFileLists(prep?.fileOps);
      finalSummary += formatFileOperations(readFiles, modifiedFiles);
    } catch {
      /* 补不上就不补 */
    }

    // 事实异步写库：不能拖慢压缩，也不能因为写库失败而影响摘要交付
    this._writeMergedFacts({ facts, usedIds, chatKey: entryIn?.chatKey ?? null, entry })
      .catch((e) => logMemory.warn(`合并压缩事实写入失败: ${e?.message}`));

    return {
      compaction: {
        summary: finalSummary,
        firstKeptEntryId,
        tokensBefore: Number(prep?.tokensBefore ?? 0),
      },
    };
  }

  /**
   * 把合并压缩抽出的事实写进记忆库。
   *
   * 走 memory.writeFacts 这个公开入口（而非直接调私有 _upsertFact），
   * 保证与 harvest 路径共用同一套去重/合并规则，两条写入路径不会漂移。
   */
  async _writeMergedFacts({ facts, usedIds, chatKey, entry }) {
    if (!this.memory || !Array.isArray(facts) || !facts.length) return;
    // 来源三要素**优先取 entry**：闲置压缩（每分钟巡检）不在轮次上下文里，
    // getTurnCtx() 会是 null，此时若只依赖轮次上下文就会拿不到 userId、事实全丢。
    // entry 上的这三项在会话创建时就记下了，压缩的两条触发路径都拿得到。
    const tc = (() => {
      try {
        return getTurnCtx() ?? {};
      } catch {
        return {};
      }
    })();
    const userId = entry?.userId ?? tc?.userId ?? this.ctx?.userId;
    if (!userId) {
      logMemory.warn(`合并压缩：拿不到 userId，${facts.length} 条事实未写入`);
      return;
    }
    const chatType = entry?.chatType ?? tc?.chatType ?? this.ctx?.chatType;
    const targetId = entry?.targetId ?? tc?.targetId ?? this.ctx?.targetId;
    const n = await this.memory.writeFacts({ facts, usedIds, chatType, userId, targetId });
    if (n) logMemory.info(`合并压缩写入记忆 +${n} 条（${chatKey ?? "?"}）`);
  }

  /**
   * 压缩前收割：把**即将被丢弃的完整上下文**交给记忆库抽成长期事实。
   *
   * 【为什么把收货时机定在这里（而不是每轮结束）】
   *   · 每轮结束都跑 ⇒ 同一批内容在它被压缩之前会被反复扫描（重复劳动），
   *     还要靠 10 分钟节流压成本；而节流反过来会漏 —— 关键信息若落在被节流掉的
   *     那一轮，等到下次有机会时可能已经跑偏或过了很久。
   *   · 压缩恰好是「这批内容最后一次可见」的时刻：往后就只剩摘要了。
   *     在这里收一次，既天然去重（每段历史只会在它被丢弃前收一次），又不会漏。
   *
   * 【为什么用消息快照而不是等收割时再读】
   * compact() 一执行，session 内的消息就被摘要替换了。若等收割函数自己再去读
   * 上下文，读到的已经是压缩后的内容 —— 原文永远拿不到了。
   * 所以这里**先取快照**（structuredClone 一份纯数据），再异步交给收割。
   *
   * 【为什么异步不 await】
   * 收割要独立调一次 LLM（数秒到十几秒）。压缩本身也是长任务，串行没意义，
   * 反而让 entry.compacting 多占一段时间（会挡住新轮次的提交）。
   */
  _harvestBeforeCompact(entry, chatKey) {
    if (!this.memory) return;
    let messages;
    try {
      // buildSessionContext 是 compact-aware 的：取到的正是「当前真正喂给模型的上下文」
      // （压缩摘要 + 其后消息），与压缩要吃掉的范围一致。
      const sc = entry.session?.sessionManager?.buildSessionContext?.();
      messages = sc?.messages;
    } catch (e) {
      logMemory.warn(`${chatKey} 取上下文快照失败: ${e?.message}`);
      return;
    }
    if (!Array.isArray(messages) || !messages.length) return;

    // 深拷贝成纯数据：压缩会改写 session 内部结构，不拷就可能读到半途状态
    let snapshot;
    try {
      snapshot = typeof structuredClone === "function" ? structuredClone(messages) : JSON.parse(JSON.stringify(messages));
    } catch {
      snapshot = messages; // 拷不动就用引用兜底（最坏情况是读到压缩后内容，不致命）
    }

    const userId = entry.userId;
    if (!userId) return;
    // 权限：与原先每轮收割一致 —— 仅 harvest 授权者才写记忆
    let okHarvest = false;
    try {
      okHarvest = this.white?.perms?.(userId)?.has?.("memory.harvest") === true;
    } catch {
      okHarvest = false;
    }
    if (!okHarvest) return;

    const t0 = Date.now();
    this.memory
      .harvest({
        session: chatKey,
        userId,
        chatType: entry.chatType,
        targetId: entry.targetId,
        messages: snapshot,
        priorIds: entry.lastInjectedIds,
      })
      .then((r) => {
        const ms = Date.now() - t0;
        if (r?.count) logMemory.info(`${chatKey} 压缩前收割 +${r.count} 条（${ms}ms）`);
        else if (r?.reason && r.reason !== "throttled") logMemory.info(`${chatKey} 压缩前收割无新增（${r.reason} · ${ms}ms）`);
        if (r?.used) logMemory.info(`${chatKey} 使用信号 +${r.used}`);
      })
      .catch((e) => logMemory.warn(`${chatKey} 压缩前收割失败: ${e?.message}`));
  }

  async disposeAll() {
    for (const [, entry] of this.sessions) entry.session.dispose();
    this.sessions.clear();
  }
}

/**
 * 把一段临时文本挂到「报文最后一条消息」的末尾。
 *
 * 之所以挂在最后一条而不是别处：它是缓存分叉点能容忍的最后一个位置 ——
 * 前面所有内容（system + 整段历史）都保持逐字节不变，前缀缓存照常命中。
 *
 * 兼容两种报文形态：
 *  · OpenAI 兼容（omniroute/deepseek 都是）：{ messages: [...] }，content 为字符串或分片数组
 *  · 直接传数组的（个别 provider/SDK 路径）：[...]
 *
 * @param {unknown} payload 请求报文
 * @param {string} text 要附加的文本
 * @returns {boolean} 是否成功附加
 */
export function appendTailBlock(payload, text) {
  const msgs = Array.isArray(payload) ? payload : payload?.messages;
  if (!Array.isArray(msgs) || !msgs.length) return false;
  const last = msgs[msgs.length - 1];
  if (!last || typeof last !== "object") return false;
  // 角色判断必须排在最前：助手消息里出现「本轮临时块」会被模型当成它自己刚说过的话
  if (last.role === "assistant") {
    msgs.push({ role: "user", content: text });
    return true;
  }
  // 【必须换对象，不得原地改】本次临时块只对「这一份请求」有效，
  // 绝不能回写到会话记录里（否则下一条消息会看到一串历史注入副本，
  // 既污染上下文又会让模型把旧权限当成当前权限）。
  // 做法：构造一个新消息替代数组末位 —— 数组是本次请求的，但消息对象可能与会话共享。
  if (typeof last.content === "string") {
    msgs[msgs.length - 1] = { ...last, content: last.content + "\n\n" + text };
  } else if (Array.isArray(last.content)) {
    msgs[msgs.length - 1] = { ...last, content: [...last.content, { type: "text", text }] };
  } else {
    msgs[msgs.length - 1] = { ...last, content: text };
  }
  return true;
}

export function createPiAgent({ bridge }) {
  return new PiAgent({ bridge });
}