/**
 * 强制把会话的思考等级设为 config.pi.thinkingLevel（默认 max）。
 *
 * 【为什么打开会话时还要再设一遍】
 * 会话文件里会持久化一条 thinking_level_change，恢复会话时 SDK 会用它，
 * 于是**旧会话会带着旧等级继续跑**（实测：有的会话是 off，有的是 high）。
 * 只在 settings 里给默认值管不到这些存量会话，必须每次打开都覆盖一次。
 *
 * 等级不受模型支持时 SDK 的 clampThinkingLevel 会自动落到相邻可用档，
 * 所以这里不需要先探测能力，也不会因换模型而报错。
 *
 * @param {import("@earendil-works/pi-coding-agent").AgentSession} session
 */
function applyThinkingLevel(session) {
  try {
    const level = defaultThinkingLevel();
    if (session.thinkingLevel === level) return;
    session.setThinkingLevel(level);
    logPi.info(`思考等级 → ${session.thinkingLevel}（请求 ${level}）`);
  } catch (e) {
    // 设置失败不应该影响会话可用性，记一笔就好
    logPi.warn(`设置思考等级失败: ${e?.message}`);
  }
}
