/* ── 可用工具清单（供 _permBlock 生成「你能调什么」） ──────────────────────
 *
 * 【为什么不直接列 TOOL_PERM 的 key】
 *  1. 模型看不懂 `memory.search` 这种 token，需要一句人话说明；
 *  2. TOOL_PERM 为 null 的条目并非都「人人可用」：
 *     凭据工具只在 files:full 下才注册（见 tools/index.mjs 的 buildTools），
 *     perms 为空时 SDK 的 noTools="all" 会把所有工具（含 null 的）全过滤掉。
 *  3. SDK 内置文件工具（read/write/edit/bash/ls/find/grep）不在 TOOL_PERM 里，
 *     但 files:full 下确实挂载，不列会让模型以为自己没有 bash。
 */

/** 仅 admin（files:full）才注册的工具 */
const ADMIN_ONLY_TOOLS = new Set(["get_credential", "save_credential"]);

/**
 * 无任何权限（dialog）的用户也能用的工具。
 *
 * 【为什么要有这一档】(2026-10-20 用户要求)
 * 联网搜索应当对所有用户开放 —— 它是纯只读的外部信息获取，不触及本机文件、
 * 不执行命令、不改任何状态，给最低权限的对话用户用不会扩大攻击面。
 * 同时把 TOOL_PERM 标为 null 的那三个（回复通道 / 提醒）一并留下，
 * 因为它们本来就是「所有会话可用」的语义，之前被 noTools="all" 误伤。
 *
 * 【实现方式】SDK 的 `options.tools` 是显式白名单：
 *     allowedToolNames = options.tools ?? (noTools === "all" ? [] : undefined)
 * 传了它就以它为准，不会落到空数组。所以 dialog 不需要再靠 noTools="all" 裸关全部，
 * 而是改成「只开这几个」。
 */
const PUBLIC_TOOLS = ["web_search", "fetch_content", "qq_send_message", "set_reminder", "list_reminders"];

